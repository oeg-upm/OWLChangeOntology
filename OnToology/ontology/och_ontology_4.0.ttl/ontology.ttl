:sourceAddRelationToIndividual rdf:type owl:ObjectProperty ;
                               rdfs:domain :AddRelationToIndividual ;
                               rdfs:range owl:NamedIndividual ;
                               rdfs:comment "The individual that is the subject of the relation being added in a change operation" ;
                               rdfs:label "source add relation to individuals" .


###  https://w3id.org/def/och#sourceAddSubClass
:sourceAddSubClass rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :sourceClass ;
                   rdfs:domain :AddSubClass ;
                   rdfs:range owl:Class ;
                   rdfs:comment "The subject of the subClass relation being added" ;
                   rdfs:label "source AddSubClass" .


###  https://w3id.org/def/och#sourceAddSubProperty
:sourceAddSubProperty rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :sourceProperty ;
                      rdfs:domain :AddSubPropertyOf ;
                      rdfs:range rdf:Property ;
                      rdfs:comment "The subject of the subProperty relation being added" ;
                      rdfs:label "source AddSubProperty" .


###  https://w3id.org/def/och#sourceClass
:sourceClass rdf:type owl:ObjectProperty ;
             rdfs:domain :ClassRelationChange ;
             rdfs:range owl:Class ;
             rdfs:comment "The class that is the subject of the class relations being changed in a change operation" ;
             rdfs:label "source class" .


###  https://w3id.org/def/och#sourceIndividual
:sourceIndividual rdf:type owl:ObjectProperty ;
                  rdfs:domain :IndividualRelationChange ;
                  rdfs:range owl:NamedIndividual ;
                  rdfs:comment "The individual that is the subject of the relation being changed in a change operation" ;
                  rdfs:label "source individual" .


###  https://w3id.org/def/och#sourceProperty
:sourceProperty rdf:type owl:ObjectProperty ;
                rdfs:domain :PropertyRelationChange ;
                rdfs:range rdf:Property ;
                rdfs:comment "The property that is the subject of the property relations being changed in a change operation" ;
                rdfs:label "source property" .


###  https://w3id.org/def/och#sourceRemoveAnnotationFromEntity
:sourceRemoveAnnotationFromEntity rdf:type owl:ObjectProperty ;
                                  rdfs:domain :RemoveAnnotationFromEntity ;
                                  rdfs:range rdfs:Resource ;
                                  rdfs:comment "The Entity the annotation is removed from" ;
                                  rdfs:label "source remove annotation from entity" .


###  https://w3id.org/def/och#sourceRemoveDisjointClass
:sourceRemoveDisjointClass rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :sourceClass ;
                           rdfs:domain :RemoveDisjointClass ;
                           rdfs:range owl:Class ;
                           rdfs:comment "The subject of the disjoint class relation being removed" ;
                           rdfs:label "source remove disjoint class" .


###  https://w3id.org/def/och#sourceRemoveDisjointProperty
:sourceRemoveDisjointProperty rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :sourceProperty ;
                              rdfs:domain :RemoveDisjointProperty ;
                              rdfs:range rdf:Property ;
                              rdfs:comment "The subject of the disjoint property relation being removed" ;
                              rdfs:label "source RemoveDisjointProperty" .


