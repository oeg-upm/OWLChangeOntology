@prefix : <https://w3id.org/def/och#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/def/och#> .

<https://w3id.org/def/och#> rdf:type owl:Ontology ;
                             owl:versionIRI <https://w3id.org/def/och/4.0.0> ;
                             <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/legalcode> ;
                             <http://purl.org/dc/terms/abstract> "As any other engineering product, ontologies evolve during their lifecycle due to several reasons such as accommodating new requirements or fixing issues. To keep track of these changes, several tools have defined ad-hoc formalisms to define and manage them. However, some of them are not based on standard interoperable languages such as RDF, and the RDF-based ones cover a limited set of changes. In this paper, we present the OWL Change Ontology (OCH), an ontology to capture changes in ontologies. Developed following the LOT methodology, OCH provides a declarative framework for documenting ontology changelogs. With this approach, ontologies gain a valuable resource to improve their lifecycle management, while associated semantic products such as declarative mappings (e.g., RML) and validation shapes (e.g., SHACL) can take advantage of standardized and machine-readable changelogs to streamline their schema evolution." ;
                             <http://purl.org/dc/terms/bibliographicCitation> "Conde-Herreros, D. Pernisch, R., Poveda-Villalón, M., Corcho, O., & Chaves-Fraga, D. (2024). OCH: The OWL Change Ontology" ;
                             <http://purl.org/dc/terms/contributor> "Diego Conde Herreros" ;
                             <http://purl.org/dc/terms/created> "2024-04-17"^^xsd:date ;
                             <http://purl.org/dc/terms/creator> "David Chaves-Fraga" ,
                                                                "Diego Conde-Herreros" ,
                                                                "María Poveda-Villalón" ,
                                                                "Oscar Corcho" ,
                                                                "Romana Pernisch" ;
                             <http://purl.org/dc/terms/description> "An ontology for describing changes between OWL ontology versions and the logical and computational impact of those changes" ;
                             <http://purl.org/dc/terms/modified> "2026-08-11"^^xsd:date ;
                             <http://purl.org/dc/terms/title> "OWL Change Ontology" ;
                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "och" ;
                             <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/def/och#> ;
                             owl:priorVersion <https://w3id.org/def/och/3.0.0> ;
                             owl:versionInfo "4.0.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://creativecommons.org/ns#license
<http://creativecommons.org/ns#license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#priorVersion
owl:priorVersion rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionIRI
owl:versionIRI rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
<http://www.w3.org/ns/prov#wasDerivedFrom> rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#createdWith
<https://w3id.org/mod#createdWith> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#boolean
xsd:boolean rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#dateTime
xsd:dateTime rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#decimal
xsd:decimal rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#integer
xsd:integer rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#nonNegativeInteger
xsd:nonNegativeInteger rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#string
xsd:string rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#broader
<http://www.w3.org/2004/02/skos/core#broader> rdf:type owl:ObjectProperty .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
<http://www.w3.org/2004/02/skos/core#hasTopConcept> rdf:type owl:ObjectProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty .


###  https://w3id.org/def/och#addedAnnotationToEntity
:addedAnnotationToEntity rdf:type owl:ObjectProperty ;
                         rdfs:domain :AddAnnotationToEntity ;
                         rdfs:range rdf:Property ;
                         rdfs:comment "The annotation property being added to an entity. Its range is rdf:Property to include both owl:AnnotationProperty and other annotations." ;
                         rdfs:label "added annotation to entity" .


###  https://w3id.org/def/och#addedCharacteristic
:addedCharacteristic rdf:type owl:ObjectProperty ;
                     rdfs:domain :AddCharacteristic ;
                     rdfs:range :PropertyCharacteristic ;
                     rdfs:comment "The characteristic being added to a given property" ;
                     rdfs:label "added characteristic" .


###  https://w3id.org/def/och#addedCharacteristicToProperty
:addedCharacteristicToProperty rdf:type owl:ObjectProperty ;
                               rdfs:domain :AddCharacteristic ;
                               rdfs:range rdf:Property ;
                               rdfs:comment "The property a characteristic is added to" ;
                               rdfs:label "add Characteristic to property" .


###  https://w3id.org/def/och#addedClass
:addedClass rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :addedEntity ;
            rdfs:domain :AddClass ;
            rdfs:range owl:Class ;
            rdfs:comment "The class being added in an AddClass operation" ;
            rdfs:label "added class" .


###  https://w3id.org/def/och#addedDataProperty
:addedDataProperty rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :addedEntity ;
                   rdfs:domain :AddDataProperty ;
                   rdfs:range owl:DatatypeProperty ;
                   rdfs:comment "The data property that is being added to the ontology" ;
                   rdfs:label "added data property" .


###  https://w3id.org/def/och#addedDataRange
:addedDataRange rdf:type owl:ObjectProperty ;
                rdfs:domain :AddRangeDataProperty ;
                rdfs:range rdfs:Datatype ;
                rdfs:comment "The range being added to a data property" ;
                rdfs:label "added data range" .


###  https://w3id.org/def/och#addedDomain
:addedDomain rdf:type owl:ObjectProperty ;
             rdfs:domain :AddDomain ;
             rdfs:range owl:Class ;
             rdfs:comment "The added domain of an Add Domain change operation" ;
             rdfs:label "added domain" .


###  https://w3id.org/def/och#addedDomainToProperty
:addedDomainToProperty rdf:type owl:ObjectProperty ;
                       rdfs:domain :AddDomain ;
                       rdfs:range rdf:Property ;
                       rdfs:comment "The property a domain is added to." ;
                       rdfs:label "added Domain for Property" .


###  https://w3id.org/def/och#addedEntity
:addedEntity rdf:type owl:ObjectProperty ;
             rdfs:domain :EntityChange ;
             rdfs:range rdfs:Resource ;
             rdfs:comment "The entity that is being added in a change operation" ;
             rdfs:label "added entity" .


###  https://w3id.org/def/och#addedIndividual
:addedIndividual rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :addedEntity ;
                 rdfs:domain :AddIndividual ;
                 rdfs:range owl:NamedIndividual ;
                 rdfs:comment "The individual being added in an AddIndividual operation" ;
                 rdfs:label "added individual" .


###  https://w3id.org/def/och#addedObjectProperty
:addedObjectProperty rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :addedEntity ;
                     rdfs:domain :AddObjectProperty ;
                     rdfs:range owl:ObjectProperty ;
                     rdfs:comment "The object property being added to the ontology" ;
                     rdfs:label "added object property" .


###  https://w3id.org/def/och#addedObjectRange
:addedObjectRange rdf:type owl:ObjectProperty ;
                  rdfs:domain :AddRangeObjectProperty ;
                  rdfs:range owl:Class ;
                  rdfs:comment "The range that is being added to the object property" ;
                  rdfs:label "added object range" .


###  https://w3id.org/def/och#addedProperty
:addedProperty rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :addedEntity ;
               rdfs:domain :AddProperty ;
               rdfs:range rdf:Property ;
               rdfs:comment "The property being added to the ontology" ;
               rdfs:label "added Property" .


###  https://w3id.org/def/och#addedRangeToProperty
:addedRangeToProperty rdf:type owl:ObjectProperty ;
                      rdfs:domain :AddRange ;
                      rdfs:range rdf:Property ;
                      rdfs:comment "The property to which the change is being added." ;
                      rdfs:label "add range for property" .


###  https://w3id.org/def/och#addedRelationToIndividual
:addedRelationToIndividual rdf:type owl:ObjectProperty ;
                           rdfs:domain :AddRelationToIndividual ;
                           rdfs:range rdf:Property ;
                           rdfs:comment "The individual that is the relation being added in a change operation" ;
                           rdfs:label "property add relation to individuals" .


###  https://w3id.org/def/och#affectsTerm
:affectsTerm rdf:type owl:ObjectProperty ;
             rdfs:domain :LogicalImpactAssessment ;
             rdfs:range rdfs:Resource ;
             rdfs:comment "An entity whose meaning is altered by the change." ;
             rdfs:label "affects term" .


###  https://w3id.org/def/och#assesses
:assesses rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasImpactAssessment ;
          rdfs:comment "The ontological change, change set or changelog whose impact is assessed." ;
          rdfs:label "assesses" .


###  https://w3id.org/def/och#changeCategory
:changeCategory rdf:type owl:ObjectProperty ;
                rdfs:domain :LogicalImpactAssessment ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                rdfs:comment "A fine-grained category assigned to the change, drawn from :ChangeCategoryScheme or from an external concept scheme." ;
                rdfs:label "change category" .


###  https://w3id.org/def/och#correspondingChange
:correspondingChange rdf:type owl:ObjectProperty ;
                     rdfs:domain :Axiom ;
                     rdfs:range :OntologicalChange ;
                     rdfs:comment "Links an axiom to the ontological change that introduced or removed it, when such a change is recorded in the changelog. This allows tracing why a change is ineffectual back to other changes in the same release." ;
                     rdfs:label "corresponding change" .


###  https://w3id.org/def/och#deductiveDirection
:deductiveDirection rdf:type owl:ObjectProperty ;
                    rdfs:domain :LogicalImpactAssessment ;
                    rdfs:range :DeductiveDirection ;
                    rdfs:comment "The direction in which an effectual change moves the deductive closure of the ontology." ;
                    rdfs:label "deductive direction" .


###  https://w3id.org/def/och#deprecatedEntity
:deprecatedEntity rdf:type owl:ObjectProperty ;
                  rdfs:domain :DeprecateEntity ;
                  rdfs:range rdfs:Resource ;
                  rdfs:comment "The OWL Entity that is being deprecated" ;
                  rdfs:label "deprecated entity" .


###  https://w3id.org/def/och#directlyAffectsTerm
:directlyAffectsTerm rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :affectsTerm ;
                     rdfs:domain :LogicalImpactAssessment ;
                     rdfs:range rdfs:Resource ;
                     rdfs:comment "An entity that occurs in the changed axiom itself and whose meaning is altered by it." ;
                     rdfs:label "directly affects term" .


###  https://w3id.org/def/och#entailmentRegime
:entailmentRegime rdf:type owl:ObjectProperty ;
                  rdfs:domain :ImpactAssessment ;
                  rdfs:range :EntailmentRegime ;
                  rdfs:comment "The semantics under which entailment was decided." ;
                  rdfs:label "entailment regime" .


###  https://w3id.org/def/och#fromChangelog
:fromChangelog rdf:type owl:ObjectProperty ;
               rdfs:domain :OntologicalChange ;
               rdfs:range :Changelog ;
               rdfs:comment "The fromChangelog property indicates that a given change belongs to a Changelog" ;
               rdfs:label "from changelog" .


###  https://w3id.org/def/och#gainedEntailment
:gainedEntailment rdf:type owl:ObjectProperty ;
                  rdfs:domain :LogicalImpactAssessment ;
                  rdfs:range :Axiom ;
                  rdfs:comment "An axiom entailed by the new version but not by the previous one." ;
                  rdfs:label "gained entailment" .


###  https://w3id.org/def/och#hasEntailmentJustification
:hasEntailmentJustification rdf:type owl:ObjectProperty ;
                            rdfs:domain :LogicalImpactAssessment ;
                            rdfs:range :EntailmentJustification ;
                            rdfs:comment "A minimal set of axioms explaining the verdict, typically the axioms of the previous version that already entail an ineffectually added axiom." ;
                            rdfs:label "has entailment justification" .


###  https://w3id.org/def/och#hasImpactAssessment
:hasImpactAssessment rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Changelog
                                                 :OntologicalChange
                                               )
                                 ] ;
                     rdfs:range :ImpactAssessment ;
                     rdfs:comment "Relates an ontological change or a changelog to an assessment of its impact. Since :ChangeSet is a subclass of :Changelog, assessments of change sets are covered as well and express aggregate impact." ;
                     rdfs:label "has impact assessment" .


###  https://w3id.org/def/och#hasLogicalImpact
:hasLogicalImpact rdf:type owl:ObjectProperty ;
                  rdfs:domain :OntologicalChange ;
                  rdfs:range :LogicalImpact ;
                  owl:propertyChainAxiom ( :hasImpactAssessment
                                           :logicalImpact
                                         ) ;
                  rdfs:comment "Shortcut relating a change directly to its logical impact, for consumers that do not need provenance. It is entailed by the chain of :hasImpactAssessment and :logicalImpact, and should not be the only representation when more than one assessment of the same change exists." ;
                  rdfs:label "has logical impact" .


###  https://w3id.org/def/och#indirectlyAffectsTerm
:indirectlyAffectsTerm rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :affectsTerm ;
                       rdfs:domain :LogicalImpactAssessment ;
                       rdfs:range rdfs:Resource ;
                       rdfs:comment "An entity whose meaning is altered by the change although it does not occur in the changed axiom. Separating direct from indirect effects is what makes an impact report actionable for an ontology engineer." ;
                       rdfs:label "indirectly affects term" .


###  https://w3id.org/def/och#introducesUnsatisfiableClass
:introducesUnsatisfiableClass rdf:type owl:ObjectProperty ;
                              rdfs:domain :ConsistencyImpactAssessment ;
                              rdfs:range owl:Class ;
                              rdfs:comment "A class that is satisfiable in the previous version and unsatisfiable in the new one." ;
                              rdfs:label "introduces unsatisfiable class" .


###  https://w3id.org/def/och#issuedBy
:issuedBy rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :ImpactAssessment
                                      :OntologicalChange
                                    )
                      ] ;
          rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
          rdfs:comment "The issuedBy property indicates what Agent has issued a change or produced an impact assessment." ;
          rdfs:label "issued by" .


###  https://w3id.org/def/och#justifyingAxiom
:justifyingAxiom rdf:type owl:ObjectProperty ;
                 rdfs:domain :EntailmentJustification ;
                 rdfs:range :Axiom ;
                 rdfs:comment "An axiom belonging to an entailment justification." ;
                 rdfs:label "justifying axiom" .


###  https://w3id.org/def/och#logicalImpact
:logicalImpact rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :LogicalImpactAssessment ;
               rdfs:range :LogicalImpact ;
               rdfs:comment "The logical impact established by an assessment. Functional: a single assessment yields exactly one verdict. Divergent verdicts must be expressed as separate assessments with distinct provenance." ;
               rdfs:label "logical impact" .


###  https://w3id.org/def/och#lostEntailment
:lostEntailment rdf:type owl:ObjectProperty ;
                rdfs:domain :LogicalImpactAssessment ;
                rdfs:range :Axiom ;
                rdfs:comment "An axiom entailed by the previous version but not by the new one." ;
                rdfs:label "lost entailment" .


###  https://w3id.org/def/och#newVersion
:newVersion rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Changelog
                                        :ImpactAssessment
                                      )
                        ] ;
            rdfs:range owl:Ontology ;
            rdfs:comment "The new version the ontology is updated to. When stated on an impact assessment, the version against which removals are evaluated." ;
            rdfs:label "new version" .


###  https://w3id.org/def/och#outdatedEntityName
:outdatedEntityName rdf:type owl:ObjectProperty ;
                    rdfs:domain :RenameEntity ;
                    rdfs:range rdfs:Resource ;
                    rdfs:comment "The former name of the OWL Entity that has been renamed" ;
                    rdfs:label "outdated entity name" .


###  https://w3id.org/def/och#prevVersion
:prevVersion rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Changelog
                                         :ImpactAssessment
                                       )
                         ] ;
             rdfs:range owl:Ontology ;
             rdfs:comment "The former version of the ontology that is being outdated. When stated on an impact assessment, the version against which additions are evaluated." ;
             rdfs:label "previous version" .


###  https://w3id.org/def/och#relatedChange
:relatedChange rdf:type owl:ObjectProperty ;
               rdfs:domain :OntologicalChange ;
               rdfs:range :OntologicalChange ;
               rdfs:comment "The property that indicates an unspecified relation between two Ontology Changes" ;
               rdfs:label "related change" .


###  https://w3id.org/def/och#removedAnnotationFromEntity
:removedAnnotationFromEntity rdf:type owl:ObjectProperty ;
                             rdfs:domain :RemoveAnnotationFromEntity ;
                             rdfs:range rdf:Property ;
                             rdfs:comment "The annotation property being removed from an entity. Its range is rdf:Property to include both owl:AnnotationProperty and other annotations." ;
                             rdfs:label "removed annotation from entity" .


###  https://w3id.org/def/och#removedCharacteristic
:removedCharacteristic rdf:type owl:ObjectProperty ;
                       rdfs:domain :RemoveCharacteristic ;
                       rdfs:range :PropertyCharacteristic ;
                       rdfs:comment "The characteristic that is being removed from a property" ;
                       rdfs:label "removed characteristic" .


###  https://w3id.org/def/och#removedCharacteristicFromProperty
:removedCharacteristicFromProperty rdf:type owl:ObjectProperty ;
                                   rdfs:domain :RemoveCharacteristic ;
                                   rdfs:range rdf:Property ;
                                   rdfs:comment "The property a characteristicic is removed from" ;
                                   rdfs:label "property RemoveCharacteristic" .


###  https://w3id.org/def/och#removedClass
:removedClass rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :removedEntity ;
              rdfs:domain :RemoveClass ;
              rdfs:range owl:Class ;
              rdfs:comment "The class that is being removed in an ontology" ;
              rdfs:label "removed class" .


###  https://w3id.org/def/och#removedDataProperty
:removedDataProperty rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :removedEntity ;
                     rdfs:domain :RemoveDataProperty ;
                     rdfs:range owl:DatatypeProperty ;
                     rdfs:comment "The data property that is being removed in an ontology" ;
                     rdfs:label "removed data property" .


###  https://w3id.org/def/och#removedDataRange
:removedDataRange rdf:type owl:ObjectProperty ;
                  rdfs:domain :RemoveRangeDataProperty ;
                  rdfs:range rdfs:Datatype ;
                  rdfs:comment "The range that is being removed from a Datatype Property" ;
                  rdfs:label "removed data range" .


###  https://w3id.org/def/och#removedDomain
:removedDomain rdf:type owl:ObjectProperty ;
               rdfs:domain :RemoveDomain ;
               rdfs:range owl:Class ;
               rdfs:comment "The domain that is being removed from a property" ;
               rdfs:label "removed domain" .


###  https://w3id.org/def/och#removedDomainFromProperty
:removedDomainFromProperty rdf:type owl:ObjectProperty ;
                           rdfs:domain :RemoveDomain ;
                           rdfs:range rdf:Property ;
                           rdfs:comment "The property a domain is removed from" ;
                           rdfs:label "removed Domain for Property" .


###  https://w3id.org/def/och#removedEntity
:removedEntity rdf:type owl:ObjectProperty ;
               rdfs:domain :EntityChange ;
               rdfs:range rdfs:Resource ;
               rdfs:comment "The entity that is being removed in a change operation" ;
               rdfs:label "removed entity" .


###  https://w3id.org/def/och#removedIndividual
:removedIndividual rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :removedEntity ;
                   rdfs:domain :RemoveIndividual ;
                   rdfs:range owl:NamedIndividual ;
                   rdfs:comment "The individual that is being removed in an ontology" ;
                   rdfs:label "removed individual" .


###  https://w3id.org/def/och#removedObjectProperty
:removedObjectProperty rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :removedEntity ;
                       rdfs:domain :RemoveObjectProperty ;
                       rdfs:range owl:ObjectProperty ;
                       rdfs:comment "The object property being removed from an ontology" ;
                       rdfs:label "removed object property" .


###  https://w3id.org/def/och#removedObjectRange
:removedObjectRange rdf:type owl:ObjectProperty ;
                    rdfs:domain :RemoveRangeObjectProperty ;
                    rdfs:range owl:Class ;
                    rdfs:comment "The range being removed from an object property" ;
                    rdfs:label "removed object range" .


###  https://w3id.org/def/och#removedProperty
:removedProperty rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :removedEntity ;
                 rdfs:domain :RemoveProperty ;
                 rdfs:range rdf:Property ;
                 rdfs:comment "The property being removed from the ontology" ;
                 rdfs:label "removed Property" .


###  https://w3id.org/def/och#removedRangeFromProperty
:removedRangeFromProperty rdf:type owl:ObjectProperty ;
                          rdfs:domain :RemoveRange ;
                          rdfs:range rdf:Property ;
                          rdfs:comment "The removed range for a property" ;
                          rdfs:label "removed range for property" .


###  https://w3id.org/def/och#removedRelationFromIndividual
:removedRelationFromIndividual rdf:type owl:ObjectProperty ;
                               rdfs:domain :RemoveRelationtoIndividual ;
                               rdfs:range rdf:Property ;
                               rdfs:comment "The relation being removed from an individual in a change operation" ;
                               rdfs:label "removed relation from individuals" .


###  https://w3id.org/def/och#renamedEntityName
:renamedEntityName rdf:type owl:ObjectProperty ;
                   rdfs:domain :RenameEntity ;
                   rdfs:range rdfs:Resource ;
                   rdfs:comment "The new name the OWL Entity is being renamed to" ;
                   rdfs:label "renamed entity name" .


###  https://w3id.org/def/och#repairsUnsatisfiableClass
:repairsUnsatisfiableClass rdf:type owl:ObjectProperty ;
                           rdfs:domain :ConsistencyImpactAssessment ;
                           rdfs:range owl:Class ;
                           rdfs:comment "A class that is unsatisfiable in the previous version and satisfiable in the new one." ;
                           rdfs:label "repairs unsatisfiable class" .


###  https://w3id.org/def/och#sourceAddAnnotationToEntity
:sourceAddAnnotationToEntity rdf:type owl:ObjectProperty ;
                             rdfs:domain :AddAnnotationToEntity ;
                             rdfs:range rdfs:Resource ;
                             rdfs:comment "The Entity the annotation is added to" ;
                             rdfs:label "source add annotation to entity" .


