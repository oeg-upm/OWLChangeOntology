:sourceRemoveEquivalentClass rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :sourceClass ;
                             rdfs:domain :RemoveEquivalentClass ;
                             rdfs:range owl:Class ;
                             rdfs:comment "The subject of the equivalent class relation being removed" ;
                             rdfs:label "source RemoveEquivalentClass" .


###  https://w3id.org/def/och#sourceRemoveEquivalentProperty
:sourceRemoveEquivalentProperty rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :sourceProperty ;
                                rdfs:domain :RemoveEquivalentProperty ;
                                rdfs:range rdf:Property ;
                                rdfs:comment "The subject of the equivalent property relation being removed" ;
                                rdfs:label "source RemoveEquivalentProperty" .


###  https://w3id.org/def/och#sourceRemoveInverseProperty
:sourceRemoveInverseProperty rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :sourceProperty ;
                             rdfs:domain :RemoveInverseProperty ;
                             rdfs:range rdf:Property ;
                             rdfs:comment "The subject of the inverse property relation being removed" ;
                             rdfs:label "source RemoveInverseProperty" .


###  https://w3id.org/def/och#sourceRemoveRelationToIndividual
:sourceRemoveRelationToIndividual rdf:type owl:ObjectProperty ;
                                  rdfs:domain :RemoveRelationtoIndividual ;
                                  rdfs:range owl:NamedIndividual ;
                                  rdfs:comment "The individual that is the subject of the relation being removed in a change operation" ;
                                  rdfs:label "source remove relation to individuals" .


###  https://w3id.org/def/och#sourceRemoveSubClass
:sourceRemoveSubClass rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :sourceClass ;
                      rdfs:domain :RemoveSubClass ;
                      rdfs:range owl:Class ;
                      rdfs:comment "The subject of the disjoint property relation being added" ;
                      rdfs:label "source RemoveSubClass" .


###  https://w3id.org/def/och#sourceRemoveSubProperty
:sourceRemoveSubProperty rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :sourceProperty ;
                         rdfs:domain :RemoveSubPropertyOf ;
                         rdfs:range rdf:Property ;
                         rdfs:comment "The subject of the subProperty relation being removed" ;
                         rdfs:label "source RemoveSubProperty" .


###  https://w3id.org/def/och#targetAddAnnotationToEntity
:targetAddAnnotationToEntity rdf:type owl:ObjectProperty ;
                             rdfs:domain :AddAnnotationToEntity ;
                             rdfs:range rdfs:Resource ;
                             rdfs:comment "The content of the annotation being added to an entity." ;
                             rdfs:label "target add annotation to entity" .


###  https://w3id.org/def/och#targetAddDisjointClass
:targetAddDisjointClass rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :targetClass ;
                        rdfs:domain :AddDisjointClass ;
                        rdfs:range owl:Class ;
                        rdfs:comment "The object of the disjoint class relation being added" ;
                        rdfs:label "target add disjoint class" .


###  https://w3id.org/def/och#targetAddDisjointProperty
:targetAddDisjointProperty rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :targetProperty ;
                           rdfs:domain :AddDisjointProperty ;
                           rdfs:range rdf:Property ;
                           rdfs:comment "The object of the disjoint property relation being added" ;
                           rdfs:label "target AddDisjointProperty" .


###  https://w3id.org/def/och#targetAddEquivalentClass
:targetAddEquivalentClass rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :targetClass ;
                          rdfs:domain :AddEquivalentClass ;
                          rdfs:range owl:Class ;
                          rdfs:comment "The object of the equivalent class relation being added" ;
                          rdfs:label "target AddEquivalentClass" .


###  https://w3id.org/def/och#targetAddEquivalentProperty
:targetAddEquivalentProperty rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :targetProperty ;
                             rdfs:domain :AddEquivalentProperty ;
                             rdfs:range rdf:Property ;
                             rdfs:comment "The object of the equivalent property relation being added" ;
                             rdfs:label "target AddEquivalentProperty" .


###  https://w3id.org/def/och#targetAddInverseProperty
:targetAddInverseProperty rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :targetProperty ;
                          rdfs:domain :AddInverseProperty ;
                          rdfs:range rdf:Property ;
                          rdfs:comment "The object of the inverse property relation being added" ;
                          rdfs:label "target AddInverseProperty" .


###  https://w3id.org/def/och#targetAddRelationToIndividual
:targetAddRelationToIndividual rdf:type owl:ObjectProperty ;
                               rdfs:domain :AddRelationToIndividual ;
                               rdfs:range rdfs:Resource ;
                               rdfs:comment "The individual that is the object of the relation being added in a change operation" ;
                               rdfs:label "target add relation to individuals" .


###  https://w3id.org/def/och#targetAddSubClass
:targetAddSubClass rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :targetClass ;
                   rdfs:domain :AddSubClass ;
                   rdfs:range owl:Class ;
                   rdfs:comment "The object of the subClass relation being added" ;
                   rdfs:label "target AddSubClass" .


###  https://w3id.org/def/och#targetAddSubProperty
:targetAddSubProperty rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :targetProperty ;
                      rdfs:domain :AddSubPropertyOf ;
                      rdfs:range rdf:Property ;
                      rdfs:comment "The object of the subProperty relation being added" ;
                      rdfs:label "target AddSubProperty" .


###  https://w3id.org/def/och#targetClass
:targetClass rdf:type owl:ObjectProperty ;
             rdfs:domain :ClassRelationChange ;
             rdfs:range owl:Class ;
             rdfs:comment "The class that is the object of the class relations being changed in a change operation" ;
             rdfs:label "target class" .


###  https://w3id.org/def/och#targetProperty
:targetProperty rdf:type owl:ObjectProperty ;
                rdfs:domain :PropertyRelationChange ;
                rdfs:range rdf:Property ;
                rdfs:comment "The property that is the object of the property relations being changed in a change operation" ;
                rdfs:label "target Property" .


###  https://w3id.org/def/och#targetRemoveAnnotationFromEntity
:targetRemoveAnnotationFromEntity rdf:type owl:ObjectProperty ;
                                  rdfs:domain :RemoveAnnotationFromEntity ;
                                  rdfs:range rdfs:Resource ;
                                  rdfs:comment "The content of the annotation being removed from an entity." ;
                                  rdfs:label "target remove annotation from entity" .


###  https://w3id.org/def/och#targetRemoveDisjointClass
:targetRemoveDisjointClass rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :targetClass ;
                           rdfs:domain :RemoveDisjointClass ;
                           rdfs:range owl:Class ;
                           rdfs:comment "The object of the disjoint class relation being removed" ;
                           rdfs:label "target remove disjoint class" .


###  https://w3id.org/def/och#targetRemoveDisjointProperty
:targetRemoveDisjointProperty rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :targetProperty ;
                              rdfs:domain :RemoveDisjointProperty ;
                              rdfs:range rdf:Property ;
                              rdfs:comment "The object of the disjoint property relation being removed" ;
                              rdfs:label "target RemoveDisjointProperty" .


###  https://w3id.org/def/och#targetRemoveEquivalentClass
:targetRemoveEquivalentClass rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :targetClass ;
                             rdfs:domain :RemoveEquivalentClass ;
                             rdfs:range owl:Class ;
                             rdfs:comment "The object of the equivalent class relation being removed" ;
                             rdfs:label "target RemoveEquivalentClass" .


###  https://w3id.org/def/och#targetRemoveEquivalentProperty
:targetRemoveEquivalentProperty rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :targetProperty ;
                                rdfs:domain :RemoveEquivalentProperty ;
                                rdfs:range rdf:Property ;
                                rdfs:comment "The object of the equivalent class relation being removed" ;
                                rdfs:label "target RemoveEquivalentProperty" .


###  https://w3id.org/def/och#targetRemoveInverseProperty
:targetRemoveInverseProperty rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :targetProperty ;
                             rdfs:domain :RemoveInverseProperty ;
                             rdfs:range rdf:Property ;
                             rdfs:comment "The object of the inverse property relation being removed" ;
                             rdfs:label "target RemoveInverseProperty" .


###  https://w3id.org/def/och#targetRemoveRelationToIndividual
:targetRemoveRelationToIndividual rdf:type owl:ObjectProperty ;
                                  rdfs:domain :RemoveRelationtoIndividual ;
                                  rdfs:range rdfs:Resource ;
                                  rdfs:comment "The individual that is the object of the relation being removed in a change operation" ;
                                  rdfs:label "target remove relation to individuals" .


###  https://w3id.org/def/och#targetRemoveSubClass
:targetRemoveSubClass rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :targetClass ;
                      rdfs:domain :RemoveSubClass ;
                      rdfs:range owl:Class ;
                      rdfs:comment "The object of the subClass relation being removed" ;
                      rdfs:label "target RemovesubClass" .


###  https://w3id.org/def/och#targetRemoveSubProperty
:targetRemoveSubProperty rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :targetProperty ;
                         rdfs:domain :RemoveSubPropertyOf ;
                         rdfs:range rdf:Property ;
                         rdfs:comment "The object of the subProperty relation being removed" ;
                         rdfs:label "target RemoveSubProperty" .


###  https://w3id.org/def/och#targetResource
:targetResource rdf:type owl:ObjectProperty ;
                rdfs:domain :IndividualRelationChange ;
                rdfs:range rdfs:Resource ;
                rdfs:comment "The individual that is the object of the relation being changed in a change operation" ;
                rdfs:label "target individual" .


###  https://w3id.org/def/och#undeprecatedElement
:undeprecatedElement rdf:type owl:ObjectProperty ;
                     rdfs:domain :RevokeDeprecate ;
                     rdfs:range rdfs:Resource ;
                     rdfs:comment "The ontological term that is being undeprecated" ;
                     rdfs:label "undeprecated element" .


###  https://w3id.org/def/och#usedReasoner
:usedReasoner rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :issuedBy ;
              rdfs:domain :ImpactAssessment ;
              rdfs:range :Reasoner ;
              rdfs:comment "The reasoner used to decide entailment. Specialises :issuedBy, since a logical impact verdict is only reproducible relative to the reasoner that produced it." ;
              rdfs:label "used reasoner" .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:DatatypeProperty .


###  https://w3id.org/def/och#assessedAt
:assessedAt rdf:type owl:DatatypeProperty ;
            rdfs:domain :ImpactAssessment ;
            rdfs:range xsd:dateTime ;
            rdfs:comment "The moment at which the assessment was produced." ;
            rdfs:label "assessed at" .


###  https://w3id.org/def/och#axiomExpression
:axiomExpression rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Axiom ;
                 rdfs:range xsd:string ;
                 rdfs:comment "A serialisation of the axiom, by default in OWL 2 Functional-Style Syntax. Use :axiomSyntax to declare a different one." ;
                 rdfs:label "axiom expression" .


###  https://w3id.org/def/och#axiomSyntax
:axiomSyntax rdf:type owl:DatatypeProperty ;
             rdfs:domain :Axiom ;
             rdfs:range xsd:string ;
             rdfs:comment "The concrete syntax used in :axiomExpression." ;
             rdfs:label "axiom syntax" .


###  https://w3id.org/def/och#classificationTimeAfter
:classificationTimeAfter rdf:type owl:DatatypeProperty ;
                         rdfs:domain :ReasoningPerformanceAssessment ;
                         rdfs:range xsd:decimal ;
                         rdfs:comment "The classification time of the new version, in milliseconds." ;
                         rdfs:label "classification time after" .


###  https://w3id.org/def/och#classificationTimeBefore
:classificationTimeBefore rdf:type owl:DatatypeProperty ;
                          rdfs:domain :ReasoningPerformanceAssessment ;
                          rdfs:range xsd:decimal ;
                          rdfs:comment "The classification time of the previous version, in milliseconds." ;
                          rdfs:label "classification time before" .


###  https://w3id.org/def/och#justification
:justification rdf:type owl:DatatypeProperty ;
               rdfs:domain :OntologicalChange ;
               rdfs:range xsd:string ;
               rdfs:comment "The reasons and justifications behind a particular change, in natural language. Not to be confused with :EntailmentJustification, which is the set of axioms that logically entail a change." ;
               rdfs:label "justification" .


###  https://w3id.org/def/och#justificationCount
:justificationCount rdf:type owl:DatatypeProperty ;
                    rdfs:domain :LogicalImpactAssessment ;
                    rdfs:range xsd:nonNegativeInteger ;
                    rdfs:comment "The number of distinct entailment justifications found. Useful when justifications are too numerous to enumerate, and an indicator of how entrenched a redundancy is." ;
                    rdfs:label "justification count" .


###  https://w3id.org/def/och#materialisationDelta
:materialisationDelta rdf:type owl:DatatypeProperty ;
                      rdfs:domain :MaterialisationImpactAssessment ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "The net change in the number of materialised triples. Negative values denote a loss of inferred content." ;
                      rdfs:label "materialisation delta" .


###  https://w3id.org/def/och#materialisedTriplesAfter
:materialisedTriplesAfter rdf:type owl:DatatypeProperty ;
                          rdfs:domain :MaterialisationImpactAssessment ;
                          rdfs:range xsd:nonNegativeInteger ;
                          rdfs:comment "The size of the materialisation of the new version." ;
                          rdfs:label "materialised triples after" .


###  https://w3id.org/def/och#materialisedTriplesBefore
:materialisedTriplesBefore rdf:type owl:DatatypeProperty ;
                           rdfs:domain :MaterialisationImpactAssessment ;
                           rdfs:range xsd:nonNegativeInteger ;
                           rdfs:comment "The size of the materialisation of the previous version." ;
                           rdfs:label "materialised triples before" .


###  https://w3id.org/def/och#preservesCoherence
:preservesCoherence rdf:type owl:DatatypeProperty ;
                    rdfs:domain :ConsistencyImpactAssessment ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Whether the change introduces no new unsatisfiable classes." ;
                    rdfs:label "preserves coherence" .


###  https://w3id.org/def/och#preservesConsistency
:preservesConsistency rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ConsistencyImpactAssessment ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Whether the new version is consistent, given that the previous one was." ;
                      rdfs:label "preserves consistency" .


###  https://w3id.org/def/och#reasoningTimeout
:reasoningTimeout rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ImpactAssessment ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "The time limit in seconds applied to each entailment check. Stating it is what makes an :Undetermined verdict interpretable." ;
                  rdfs:label "reasoning timeout" .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#Property
rdf:Property rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Datatype
rdfs:Datatype rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#Class
owl:Class rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#DatatypeProperty
owl:DatatypeProperty rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#NamedIndividual
owl:NamedIndividual rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#ObjectProperty
owl:ObjectProperty rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#Ontology
owl:Ontology rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  http://www.w3.org/ns/dcat#Dataset
<http://www.w3.org/ns/dcat#Dataset> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Activity
<http://www.w3.org/ns/prov#Activity> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
<http://www.w3.org/ns/prov#Entity> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#SoftwareAgent
<http://www.w3.org/ns/prov#SoftwareAgent> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Agent
<http://xmlns.com/foaf/0.1/Agent> rdf:type owl:Class .


###  https://w3id.org/def/och#AddAnnotationToEntity
:AddAnnotationToEntity rdf:type owl:Class ;
                       rdfs:subClassOf :EntityAnnotationChange ;
                       rdfs:comment "The change operation that corresponds to the addition of the annotation of an entity" ;
                       rdfs:label "Add Annotation to Entity" .


###  https://w3id.org/def/och#AddCharacteristic
:AddCharacteristic rdf:type owl:Class ;
                   rdfs:subClassOf :PropertyCharacteristicChange ;
                   rdfs:comment "The change operation corresponding to addition of a characteristic to a property" ;
                   rdfs:label "Add Characteristic" .


###  https://w3id.org/def/och#AddClass
:AddClass rdf:type owl:Class ;
          rdfs:subClassOf :ClassChange ;
          rdfs:comment "The change operation corresponding to the addition of a class" ;
          rdfs:label "Add Class" .


###  https://w3id.org/def/och#AddDataProperty
:AddDataProperty rdf:type owl:Class ;
                 rdfs:subClassOf :AddProperty ,
                                 :DataPropertyChange ;
                 rdfs:comment "The change operation corresponding to the addition of a data property" ;
                 rdfs:label "Add Data Property" ;
                 <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddDataProperty> .


###  https://w3id.org/def/och#AddDisjointClass
:AddDisjointClass rdf:type owl:Class ;
                  rdfs:subClassOf :DisjointClassChange ;
                  rdfs:comment "The change operation corresponding to the addition of an disjoint class relation between two classes" ;
                  rdfs:label "Add Disjoint Class" .


###  https://w3id.org/def/och#AddDisjointProperty
:AddDisjointProperty rdf:type owl:Class ;
                     rdfs:subClassOf :DisjointPropertyChange ;
                     rdfs:comment "The change operation corresponding to the addition of a Disjoint Property relation between two properties" ;
                     rdfs:label "Add Disjoint Property" .


###  https://w3id.org/def/och#AddDomain
:AddDomain rdf:type owl:Class ;
           rdfs:subClassOf :DomainChange ;
           rdfs:comment "The change operation corresponding to the addition of the domain to a given property" ;
           rdfs:label "Add Domain" ;
           <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddDomain> .


###  https://w3id.org/def/och#AddEquivalentClass
:AddEquivalentClass rdf:type owl:Class ;
                    rdfs:subClassOf :EquivalentClassChange ;
                    rdfs:comment "The change operation corresponding to the addition of an equivalent class relation between two classes" ;
                    rdfs:label "Add Equivalent Class" ;
                    <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddEquivalentClass> .


###  https://w3id.org/def/och#AddEquivalentProperty
:AddEquivalentProperty rdf:type owl:Class ;
                       rdfs:subClassOf :EquivalentPropertyChange ;
                       rdfs:comment "The change operation corresponding to the addition of an equivalent property relation between two properties" ;
                       rdfs:label "Add Equivalent Property" .


###  https://w3id.org/def/och#AddIndividual
:AddIndividual rdf:type owl:Class ;
               rdfs:subClassOf :IndividualChange ;
               rdfs:comment "The change operation corresponding to the addition of an individual to the ontology" ;
               rdfs:label "Add Individual" .


###  https://w3id.org/def/och#AddInverseProperty
:AddInverseProperty rdf:type owl:Class ;
                    rdfs:subClassOf :InversePropertyChange ;
                    rdfs:comment "The change operation corresponding to the addition of an inverse property relation between two properties" ;
                    rdfs:label "Add Inverse Property" .


###  https://w3id.org/def/och#AddObjectProperty
:AddObjectProperty rdf:type owl:Class ;
                   rdfs:subClassOf :AddProperty ,
                                   :ObjectPropertyChange ;
                   rdfs:comment "The change operation corresponding to the addition of an object property" ;
                   rdfs:label "Add Object Property" ;
                   <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddObjectProperty> .


###  https://w3id.org/def/och#AddProperty
:AddProperty rdf:type owl:Class ;
             rdfs:subClassOf :PropertyChange ;
             rdfs:comment "The class that represents the addition of a property to an ontology" ;
             rdfs:label "Add Property" ;
             <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddProperty> .


###  https://w3id.org/def/och#AddRange
:AddRange rdf:type owl:Class ;
          rdfs:subClassOf :RangeChange ;
          rdfs:comment "The change operation corresponding to the addition of the range to a given property" ;
          rdfs:label "Add Range" ;
          <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddRange> .


###  https://w3id.org/def/och#AddRangeDataProperty
:AddRangeDataProperty rdf:type owl:Class ;
                      rdfs:subClassOf :AddRange ;
                      rdfs:comment "The change operation corresponding to the addition of the range of a given data property" ;
                      rdfs:label "Add Range Data Property" .


###  https://w3id.org/def/och#AddRangeObjectProperty
:AddRangeObjectProperty rdf:type owl:Class ;
                        rdfs:subClassOf :AddRange ;
                        rdfs:comment "The change operation corresponding to the addition of the range of a given object property" ;
                        rdfs:label "Add Range Object Property" .


###  https://w3id.org/def/och#AddRelationToIndividual
:AddRelationToIndividual rdf:type owl:Class ;
                         rdfs:subClassOf :IndividualRelationChange ;
                         rdfs:comment "The change operation corresponding to the addition of a relation between two individuals" ;
                         rdfs:label "Add Relation to Individual" .


###  https://w3id.org/def/och#AddSubClass
:AddSubClass rdf:type owl:Class ;
             rdfs:subClassOf :SubClassChange ;
             rdfs:comment "The change operation corresponding to the addition of a subClass relation between two classes" ;
             rdfs:label "Add Sub Class" .


###  https://w3id.org/def/och#AddSubPropertyOf
:AddSubPropertyOf rdf:type owl:Class ;
                  rdfs:subClassOf :SubPropertyChange ;
                  rdfs:comment "The change operation corresponding to the addition of a subProperty relation between two properties" ;
                  rdfs:label "Add Sub Property Of" ;
                  <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddSubPropertyOf> .


###  https://w3id.org/def/och#Axiom
:Axiom rdf:type owl:Class ;
       rdfs:comment "An OWL axiom referenced by an impact assessment, for instance as a member of an entailment justification or as an entailment gained or lost. Where the axiom is itself recorded as a change in the changelog, :correspondingChange links the two."@en ;
       rdfs:label "Axiom"@en .


###  https://w3id.org/def/och#ChangeSet
:ChangeSet rdf:type owl:Class ;
           rdfs:subClassOf :Changelog ;
           rdfs:comment "The class for representing sets of changes, it can be used for representing complex changes made out of atomic changes." ;
           rdfs:label "Change Set" .


###  https://w3id.org/def/och#Changelog
:Changelog rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/ns/dcat#Dataset> ;
           rdfs:comment "The set of change operations between ontology versions" ;
           rdfs:label "Changelog" .


###  https://w3id.org/def/och#ClassChange
:ClassChange rdf:type owl:Class ;
             rdfs:subClassOf :EntityChange ;
             rdfs:comment "The change operation corresponding to the change of a given class within the ontology" ;
             rdfs:label "Class Change" ;
             <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesClassChange> .


###  https://w3id.org/def/och#ClassRelationChange
:ClassRelationChange rdf:type owl:Class ;
                     rdfs:subClassOf :ClassChange ;
                     rdfs:comment "The change operation corresponding to the change of the relationship between two classes" ;
                     rdfs:label "Class Relation Change" .


###  https://w3id.org/def/och#ConsistencyImpactAssessment
:ConsistencyImpactAssessment rdf:type owl:Class ;
                             rdfs:subClassOf :ImpactAssessment ;
                             rdfs:comment "An assessment of whether a change preserves the consistency of the ontology and the satisfiability of its classes."@en ;
                             rdfs:label "Consistency Impact Assessment"@en .


###  https://w3id.org/def/och#DataPropertyChange
:DataPropertyChange rdf:type owl:Class ;
                    rdfs:subClassOf :PropertyChange ;
                    rdfs:comment "The change operation corresponding to the change of a data property" ;
                    rdfs:label "Data Property Change" ;
                    <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesDataPropertyChange> .


###  https://w3id.org/def/och#DeductiveDirection
:DeductiveDirection rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                    rdfs:comment "The top term that encompasses the directions in which an effectual change can move the deductive closure of an ontology."@en ;
                    rdfs:label "Deductive Direction"@en .


###  https://w3id.org/def/och#DeprecateEntity
:DeprecateEntity rdf:type owl:Class ;
                 rdfs:subClassOf :EntityChange ;
                 rdfs:comment "The change operation corresponding to the deprecation of an OWL Entity" ;
                 rdfs:label "Deprecate Entity" .


###  https://w3id.org/def/och#DisjointClassChange
:DisjointClassChange rdf:type owl:Class ;
                     rdfs:subClassOf :ClassRelationChange ;
                     rdfs:comment "The change operation corresponding to the change of an disjoint class relation between two classes" ;
                     rdfs:label "Disjoint Class Change" .


###  https://w3id.org/def/och#DisjointPropertyChange
:DisjointPropertyChange rdf:type owl:Class ;
                        rdfs:subClassOf :PropertyRelationChange ;
                        rdfs:comment "The change operation corresponding to the change of a Disjoint Property" ;
                        rdfs:label "Disjoint Property Change" .


###  https://w3id.org/def/och#DomainChange
:DomainChange rdf:type owl:Class ;
              rdfs:subClassOf :PropertyChange ;
              rdfs:comment "The change operation corresponding to the change of the domain of a given property" ;
              rdfs:label "Domain Change" .


###  https://w3id.org/def/och#EntailmentJustification
:EntailmentJustification rdf:type owl:Class ;
                         rdfs:comment "A minimal subset of an ontology that entails a given axiom. Entailment justifications explain why an ineffectual change is ineffectual, and are the basis on which ineffectual changes are further categorised. A single change may have several justifications. Not to be confused with :justification, which records the rationale behind a change in natural language."@en ;
                         rdfs:label "Entailment Justification"@en .


###  https://w3id.org/def/och#EntailmentRegime
:EntailmentRegime rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "The top term that encompasses the semantics under which entailment is decided."@en ;
                  rdfs:label "Entailment Regime"@en .


###  https://w3id.org/def/och#EntityAnnotationChange
:EntityAnnotationChange rdf:type owl:Class ;
                        rdfs:subClassOf :EntityChange ;
                        rdfs:comment "The change operation that corresponds to the change of the annotation of an entity" ;
                        rdfs:label "Change to the Annotation of an Entity" .


###  https://w3id.org/def/och#EntityChange
:EntityChange rdf:type owl:Class ;
              rdfs:subClassOf :OntologicalChange ;
              rdfs:comment "The class that represents all changes to OWL Entities: classes, properties, and individuals" ;
              rdfs:label "Entity Change" .


###  https://w3id.org/def/och#EquivalentClassChange
:EquivalentClassChange rdf:type owl:Class ;
                       rdfs:subClassOf :ClassRelationChange ;
                       rdfs:comment "The change operation corresponding to the change of an equivalent class relation between two classes" ;
                       rdfs:label "Equivalent Class Change" ;
                       <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesEquivalentClassChange> .


###  https://w3id.org/def/och#EquivalentPropertyChange
:EquivalentPropertyChange rdf:type owl:Class ;
                          rdfs:subClassOf :PropertyRelationChange ;
                          rdfs:comment "The change operation corresponding to the change of an equivalent property relation between two properties" ;
                          rdfs:label "Equivalent Property Change" .


###  https://w3id.org/def/och#ImpactAnalysis
:ImpactAnalysis rdf:type owl:Class ;
                rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
                rdfs:comment "The computational process that produces one or more impact assessments. Recording it is optional, since :usedReasoner and :assessedAt cover the common case of a single tool invocation."@en ;
                rdfs:label "Impact Analysis"@en .


###  https://w3id.org/def/och#ImpactAssessment
:ImpactAssessment rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                  rdfs:comment "The outcome of evaluating the impact of an ontological change, change set or changelog. An assessment is always relative to a pair of ontology versions, stated with :prevVersion and :newVersion, and where reasoning is involved to an entailment regime and a reasoner. Impact is reified rather than asserted as a type of the change itself, because whether a change is effectual holds only relative to those parameters."@en ;
                  rdfs:label "Impact Assessment"@en .


###  https://w3id.org/def/och#IndividualChange
:IndividualChange rdf:type owl:Class ;
                  rdfs:subClassOf :EntityChange ;
                  rdfs:comment "The change operation corresponding to the change of a given individual within the ontology" ;
                  rdfs:label "Individual Change" .


###  https://w3id.org/def/och#IndividualRelationChange
:IndividualRelationChange rdf:type owl:Class ;
                          rdfs:subClassOf :IndividualChange ;
                          rdfs:comment "The change operation corresponding to the change of a relationship between two individuals within the ontology" ;
                          rdfs:label "Individual Relation Change" .


###  https://w3id.org/def/och#InversePropertyChange
:InversePropertyChange rdf:type owl:Class ;
                       rdfs:subClassOf :PropertyRelationChange ;
                       rdfs:comment "The change operation corresponding to the change of an inverse prop7 relation between two properties" ;
                       rdfs:label "Inverse Property Change" .


###  https://w3id.org/def/och#LogicalImpact
:LogicalImpact rdf:type owl:Class ;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "The top term that encompasses the possible effects of a change on the set of axioms entailed by an ontology."@en ;
               rdfs:label "Logical Impact"@en .


###  https://w3id.org/def/och#LogicalImpactAssessment
:LogicalImpactAssessment rdf:type owl:Class ;
                         rdfs:subClassOf :ImpactAssessment ;
                         rdfs:comment "An assessment of whether a change alters the set of axioms entailed by an ontology, that is, whether the change is logically effectual or ineffectual."@en ;
                         rdfs:label "Logical Impact Assessment"@en .


###  https://w3id.org/def/och#MaterialisationImpactAssessment
:MaterialisationImpactAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf :ImpactAssessment ;
                                 rdfs:comment "An assessment of the effect of a change on the materialised, that is inferred, triples of an ontology or of a knowledge graph built from it."@en ;
                                 rdfs:label "Materialisation Impact Assessment"@en .


###  https://w3id.org/def/och#ObjectPropertyChange
:ObjectPropertyChange rdf:type owl:Class ;
                      rdfs:subClassOf :PropertyChange ;
                      rdfs:comment "The change operation corresponding to the change of an object property" ;
                      rdfs:label "Object Property Change" ;
                      <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesObjectPropertyChange> .


###  https://w3id.org/def/och#ObjectPropertyCharacteristic
:ObjectPropertyCharacteristic rdf:type owl:Class ;
                              rdfs:subClassOf :PropertyCharacteristic ;
                              rdfs:comment "The term that describes those property characteristics that are exclusive to object properties"@en ;
                              rdfs:label "Object Property Characteristic"@en .


###  https://w3id.org/def/och#OntologicalChange
:OntologicalChange rdf:type owl:Class ;
                   rdfs:comment "The class that represents all changes within an ontology being term-level, structural level, or higher level" ;
                   rdfs:label "Ontological Change" ;
                   <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesOntologyChange> .


###  https://w3id.org/def/och#PropertyChange
:PropertyChange rdf:type owl:Class ;
                rdfs:subClassOf :EntityChange ;
                rdfs:comment "The class that represents changes to properties" ;
                rdfs:label "Property Change" .


###  https://w3id.org/def/och#PropertyCharacteristic
:PropertyCharacteristic rdf:type owl:Class ;
                        rdfs:comment "The top term that encompases all characteristics"@en ;
                        rdfs:label "Property Characteristic"@en .


###  https://w3id.org/def/och#PropertyCharacteristicChange
:PropertyCharacteristicChange rdf:type owl:Class ;
                              rdfs:subClassOf :PropertyChange ;
                              rdfs:comment "The change operation corresponding to the change of a property characteristic." ;
                              rdfs:label "Property Characteristic Change" .


###  https://w3id.org/def/och#PropertyRelationChange
:PropertyRelationChange rdf:type owl:Class ;
                        rdfs:subClassOf :PropertyChange ;
                        rdfs:comment "The class that represents changes to property relations" ;
                        rdfs:label "Property Relation Change" .


###  https://w3id.org/def/och#RangeChange
:RangeChange rdf:type owl:Class ;
             rdfs:subClassOf :PropertyChange ;
             rdfs:comment "The change operation corresponding to the change of the range of a given property" ;
             rdfs:label "Range Change" .


###  https://w3id.org/def/och#Reasoner
:Reasoner rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/ns/prov#SoftwareAgent> ,
                          <http://xmlns.com/foaf/0.1/Agent> ;
          rdfs:comment "A software agent that decides entailment. Recording it is what makes a logical impact verdict reproducible, since a reasoner that is incomplete for the expressivity of the ontology may fail to establish an entailment that holds."@en ;
          rdfs:label "Reasoner"@en .


###  https://w3id.org/def/och#ReasoningPerformanceAssessment
:ReasoningPerformanceAssessment rdf:type owl:Class ;
                                rdfs:subClassOf :ImpactAssessment ;
                                rdfs:comment "An assessment of the effect of a change on the computational cost of reasoning, typically classification time. Syntactically local edits are known to cause large and hard to anticipate swings in reasoner performance."@en ;
                                rdfs:label "Reasoning Performance Assessment"@en .


###  https://w3id.org/def/och#RemoveAnnotationFromEntity
:RemoveAnnotationFromEntity rdf:type owl:Class ;
                            rdfs:subClassOf :EntityAnnotationChange ;
                            rdfs:comment "The change operation that corresponds to the removal of the annotation of an entity" ;
                            rdfs:label "Remove Annotation from Entity" .


###  https://w3id.org/def/och#RemoveCharacteristic
:RemoveCharacteristic rdf:type owl:Class ;
                      rdfs:subClassOf :PropertyCharacteristicChange ;
                      rdfs:comment "The change operation corresponding to the removal of a property characteristic" ;
                      rdfs:label "Remove Characteristic" .


###  https://w3id.org/def/och#RemoveClass
:RemoveClass rdf:type owl:Class ;
             rdfs:subClassOf :ClassChange ;
             rdfs:comment "The change operation corresponding to the removal of a class" ;
             rdfs:label "Remove Class" .


###  https://w3id.org/def/och#RemoveDataProperty
:RemoveDataProperty rdf:type owl:Class ;
                    rdfs:subClassOf :DataPropertyChange ,
                                    :RemoveProperty ;
                    rdfs:comment "The change operation corresponding to the removal of a data property" ;
                    rdfs:label "Remove Data Property" ;
                    <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveDataProperty> .


###  https://w3id.org/def/och#RemoveDisjointClass
:RemoveDisjointClass rdf:type owl:Class ;
                     rdfs:subClassOf :DisjointClassChange ;
                     rdfs:comment "The change operation corresponding to the removal of the disjoint class relation between two classes" ;
                     rdfs:label "Remove Disjoint Class" .


###  https://w3id.org/def/och#RemoveDisjointProperty
:RemoveDisjointProperty rdf:type owl:Class ;
                        rdfs:subClassOf :DisjointPropertyChange ;
                        rdfs:comment "The change operation corresponding to the removal of a Disjoint Property relation between two properties" ;
                        rdfs:label "Remove Disjoint Property" .


###  https://w3id.org/def/och#RemoveDomain
:RemoveDomain rdf:type owl:Class ;
              rdfs:subClassOf :DomainChange ;
              rdfs:comment "The change operation corresponding to the removal of the domain of a given property" ;
              rdfs:label "Remove Domain" ;
              <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveDomain> .


###  https://w3id.org/def/och#RemoveEquivalentClass
:RemoveEquivalentClass rdf:type owl:Class ;
                       rdfs:subClassOf :EquivalentClassChange ;
                       rdfs:comment "The change operation corresponding to the removal of the equivalent class relation between two classes" ;
                       rdfs:label "Remove Equivalent Class" ;
                       <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveEquivalentClass> .


###  https://w3id.org/def/och#RemoveEquivalentProperty
:RemoveEquivalentProperty rdf:type owl:Class ;
                          rdfs:subClassOf :EquivalentPropertyChange ;
                          rdfs:comment "The change operation corresponding to the removal of the equivalent property relation between two properties" ;
                          rdfs:label "Remove Equivalent Property" .


###  https://w3id.org/def/och#RemoveIndividual
:RemoveIndividual rdf:type owl:Class ;
                  rdfs:subClassOf :IndividualChange ;
                  rdfs:comment "The change operation corresponding to the removal of an individual to the ontology" ;
                  rdfs:label "Remove Individual" .


###  https://w3id.org/def/och#RemoveInverseProperty
:RemoveInverseProperty rdf:type owl:Class ;
                       rdfs:subClassOf :InversePropertyChange ;
                       rdfs:comment "The change operation corresponding to the removal of the inverse property relation between two properties" ;
                       rdfs:label "Remove Inverse Property" .


###  https://w3id.org/def/och#RemoveObjectProperty
:RemoveObjectProperty rdf:type owl:Class ;
                      rdfs:subClassOf :ObjectPropertyChange ,
                                      :RemoveProperty ;
                      rdfs:comment "The change operation corresponding to the removal of an object property" ;
                      rdfs:label "Remove Object Property" ;
                      <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveObjectProperty> .


###  https://w3id.org/def/och#RemoveProperty
:RemoveProperty rdf:type owl:Class ;
                rdfs:subClassOf :PropertyChange ;
                rdfs:comment "The class that represents the removal of a property to an ontology" ;
                rdfs:label "Remove Property" ;
                <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveProperty> .


###  https://w3id.org/def/och#RemoveRange
:RemoveRange rdf:type owl:Class ;
             rdfs:subClassOf :RangeChange ;
             rdfs:comment "The change operation corresponding to the removal of the range of a given property" ;
             rdfs:label "Remove Range" ;
             <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveRange> .


###  https://w3id.org/def/och#RemoveRangeDataProperty
:RemoveRangeDataProperty rdf:type owl:Class ;
                         rdfs:subClassOf :RemoveRange ;
                         rdfs:comment "The change operation corresponding to the removal of the range of a data property" ;
                         rdfs:label "Remove Range Data Property" .


###  https://w3id.org/def/och#RemoveRangeObjectProperty
:RemoveRangeObjectProperty rdf:type owl:Class ;
                           rdfs:subClassOf :RemoveRange ;
                           rdfs:comment "The change operation corresponding to the removal of the range off an object property" ;
                           rdfs:label "Remove Range Object Property" .


###  https://w3id.org/def/och#RemoveRelationFromIndividual
:RemoveRelationFromIndividual rdf:type owl:Class ;
                              rdfs:subClassOf :IndividualRelationChange ;
                              rdfs:comment "The change operation corresponding to the removal of a relation between two individuals" ;
                              rdfs:label "Remove Relation from Individuals" .


###  https://w3id.org/def/och#RemoveRelationtoIndividual
:RemoveRelationtoIndividual rdf:type owl:Class .


###  https://w3id.org/def/och#RemoveSubClass
:RemoveSubClass rdf:type owl:Class ;
                rdfs:subClassOf :SubClassChange ;
                rdfs:comment "The change operation corresponding to the removal of the subClass relation between two classes" ;
                rdfs:label "Remove Sub Class" .


###  https://w3id.org/def/och#RemoveSubPropertyOf
:RemoveSubPropertyOf rdf:type owl:Class ;
                     rdfs:subClassOf :SubPropertyChange ;
                     rdfs:comment "The change operation corresponding to the removal of the subProperty relation between two properties" ;
                     rdfs:label "Remove Sub Property Of" ;
                     <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveSubPropertyOf> .


###  https://w3id.org/def/och#RenameEntity
:RenameEntity rdf:type owl:Class ;
              rdfs:subClassOf :EntityChange ;
              rdfs:comment "The change operation corresponding to the renaming of an OWL Entity within an ontology, this is whenever the semantics do not change and only the URI is modified" ;
              rdfs:label "Rename Entity" .


###  https://w3id.org/def/och#RevokeDeprecate
:RevokeDeprecate rdf:type owl:Class ;
                 rdfs:subClassOf :EntityChange ;
                 rdfs:comment "The change operation corresponding to the revokal of an ontological term" ;
                 rdfs:label "Revoke Deprecate" .


###  https://w3id.org/def/och#SubClassChange
:SubClassChange rdf:type owl:Class ;
                rdfs:subClassOf :ClassRelationChange ;
                rdfs:comment "The class that represents changes to a subclass relationship between two classes." ;
                rdfs:label "Sub Class Change" .


###  https://w3id.org/def/och#SubPropertyChange
:SubPropertyChange rdf:type owl:Class ;
                   rdfs:subClassOf :PropertyRelationChange ;
                   rdfs:comment "The change operation corresponding to the change of the subProperty relation between to properties" ;
                   rdfs:label "Sub Property Change" .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/def/och#AsymmetricProperty
:AsymmetricProperty rdf:type owl:NamedIndividual ,
                             :ObjectPropertyCharacteristic ;
                    rdfs:comment "The term that describes asymmetric properties."@en ;
                    rdfs:label "Asymmetric Property"@en .


###  https://w3id.org/def/och#ChangeCategoryScheme
:ChangeCategoryScheme rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                      rdfs:comment "An open concept scheme for justification-based refinements of the effectual and ineffectual distinction. Concepts added to this scheme should be related to :Effectual or :Ineffectual with skos:broader. "@en ;
                      rdfs:label "Change Category Scheme"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Extension point for fine-grained change categories."@en .


###  https://w3id.org/def/och#Effectual
:Effectual rdf:type owl:NamedIndividual ,
                    :LogicalImpact ;
           <http://www.w3.org/2004/02/skos/core#inScheme> :LogicalImpactScheme ;
           rdfs:comment "The change alters the set of entailments. An added axiom is effectual when it is not entailed by the previous version; a removed axiom is effectual when it is not entailed by the new version."@en ;
           rdfs:label "Effectual"@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Effectual"@en .


###  https://w3id.org/def/och#FunctionalProperty
:FunctionalProperty rdf:type owl:NamedIndividual ,
                             :PropertyCharacteristic ;
                    rdfs:comment "The term that describes Functional Properties."@en ;
                    rdfs:label "Functional Property"@en .


###  https://w3id.org/def/och#Ineffectual
:Ineffectual rdf:type owl:NamedIndividual ,
                      :LogicalImpact ;
             <http://www.w3.org/2004/02/skos/core#inScheme> :LogicalImpactScheme ;
             rdfs:comment "The change does not alter the set of entailments. An added axiom is ineffectual when it is already entailed by the previous version; a removed axiom is ineffectual when it remains entailed by the new version."@en ;
             rdfs:label "Ineffectual"@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Ineffectual"@en .


###  https://w3id.org/def/och#InverseFunctionalProperty
:InverseFunctionalProperty rdf:type owl:NamedIndividual ,
                                    :ObjectPropertyCharacteristic ;
                           rdfs:comment "The term that describes the inverse functional properties."@en ;
                           rdfs:label "Inverse Functional Property"@en .


###  https://w3id.org/def/och#IrreflexiveProperty
:IrreflexiveProperty rdf:type owl:NamedIndividual ,
                              :ObjectPropertyCharacteristic ;
                     rdfs:comment "The term that describes irreflexive properties."@en ;
                     rdfs:label "Irreflexive Property"@en .


###  https://w3id.org/def/och#LogicalImpactScheme
:LogicalImpactScheme rdf:type owl:NamedIndividual ,
                              <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                     <http://www.w3.org/2004/02/skos/core#hasTopConcept> :Effectual ,
                                                                         :Ineffectual ,
                                                                         :Undetermined ;
                     rdfs:comment "The concept scheme grouping the possible logical impact values."@en ;
                     rdfs:label "Logical Impact Scheme"@en .


###  https://w3id.org/def/och#OWL2DirectSemantics
:OWL2DirectSemantics rdf:type owl:NamedIndividual ,
                              :EntailmentRegime ;
                     rdfs:comment "Entailment decided under the OWL 2 Direct Semantics."@en ;
                     rdfs:label "OWL 2 Direct Semantics"@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "OWL 2 Direct Semantics"@en .


###  https://w3id.org/def/och#OWL2RDFBasedSemantics
:OWL2RDFBasedSemantics rdf:type owl:NamedIndividual ,
                                :EntailmentRegime ;
                       rdfs:comment "Entailment decided under the OWL 2 RDF-Based Semantics."@en ;
                       rdfs:label "OWL 2 RDF-Based Semantics"@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "OWL 2 RDF-Based Semantics"@en .


###  https://w3id.org/def/och#RDFSEntailment
:RDFSEntailment rdf:type owl:NamedIndividual ,
                         :EntailmentRegime ;
                rdfs:comment "Entailment decided under RDFS semantics."@en ;
                rdfs:label "RDFS Entailment"@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "RDFS Entailment"@en .


###  https://w3id.org/def/och#Refactoring
:Refactoring rdf:type owl:NamedIndividual ,
                      :DeductiveDirection ;
             rdfs:comment "The change redistributes entailments without a uniform direction, typically when a change set both gains and loses consequences."@en ;
             rdfs:label "Refactoring"@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Refactoring"@en .


###  https://w3id.org/def/och#ReflexiveProperty
:ReflexiveProperty rdf:type owl:NamedIndividual ,
                            :ObjectPropertyCharacteristic ;
                   rdfs:comment "The term that describes reflexive properties."@en ;
                   rdfs:label "Reflexive Property"@en .


###  https://w3id.org/def/och#Strengthening
:Strengthening rdf:type owl:NamedIndividual ,
                        :DeductiveDirection ;
               rdfs:comment "The change increases the set of entailments."@en ;
               rdfs:label "Strengthening"@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Strengthening"@en .


###  https://w3id.org/def/och#SymmetricProperty
:SymmetricProperty rdf:type owl:NamedIndividual ,
                            :ObjectPropertyCharacteristic ;
                   rdfs:comment "The term that describes symmetric properties."@en ;
                   rdfs:label "Symmetric Property"@en .


###  https://w3id.org/def/och#TransitiveProperty
:TransitiveProperty rdf:type owl:NamedIndividual ,
                             :ObjectPropertyCharacteristic ;
                    rdfs:comment "The term that describes transitive properties."@en ;
                    rdfs:label "Transitive Property"@en .


###  https://w3id.org/def/och#Undetermined
:Undetermined rdf:type owl:NamedIndividual ,
                       :LogicalImpact ;
              <http://www.w3.org/2004/02/skos/core#inScheme> :LogicalImpactScheme ;
              rdfs:comment "The logical impact could not be decided, for instance because the entailment check exceeded the time limit stated in :reasoningTimeout, because the reasoner is incomplete for the expressivity of the ontology, or because one of the versions could not be loaded. The value is asserted positively so that an undecided change remains distinguishable from an unassessed one."@en ;
              rdfs:label "Undetermined"@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Undetermined"@en .


###  https://w3id.org/def/och#Weakening
:Weakening rdf:type owl:NamedIndividual ,
                    :DeductiveDirection ;
           rdfs:comment "The change decreases the set of entailments."@en ;
           rdfs:label "Weakening"@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Weakening"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Effectual
                        :Ineffectual
                        :Undetermined
                      )
] .


