        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#sourceProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveEquivalentProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The subject of the equivalent property relation being removed</rdfs:comment>
        <rdfs:label>source RemoveEquivalentProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceRemoveInverseProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceRemoveInverseProperty">
