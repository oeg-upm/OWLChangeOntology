    </owl:NamedIndividual>
    


    <!-- https://w3id.org/def/och#Ineffectual -->


    <owl:NamedIndividual rdf:about="https://w3id.org/def/och#Ineffectual">
        <rdf:type rdf:resource="https://w3id.org/def/och#LogicalImpact"/>
        <skos:inScheme rdf:resource="https://w3id.org/def/och#LogicalImpactScheme"/>
        <rdfs:comment xml:lang="en">The change does not alter the set of entailments. An added axiom is ineffectual when it is already entailed by the previous version; a removed axiom is ineffectual when it remains entailed by the new version.</rdfs:comment>
        <rdfs:label xml:lang="en">Ineffectual</rdfs:label>
        <skos:prefLabel xml:lang="en">Ineffectual</skos:prefLabel>
    </owl:NamedIndividual>
    


