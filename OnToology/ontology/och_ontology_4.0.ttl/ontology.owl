    <!-- https://w3id.org/def/och#Effectual -->


    <owl:NamedIndividual rdf:about="https://w3id.org/def/och#Effectual">
        <rdf:type rdf:resource="https://w3id.org/def/och#LogicalImpact"/>
        <skos:inScheme rdf:resource="https://w3id.org/def/och#LogicalImpactScheme"/>
        <rdfs:comment xml:lang="en">The change alters the set of entailments. An added axiom is effectual when it is not entailed by the previous version; a removed axiom is effectual when it is not entailed by the new version.</rdfs:comment>
        <rdfs:label xml:lang="en">Effectual</rdfs:label>
        <skos:prefLabel xml:lang="en">Effectual</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/def/och#FunctionalProperty -->


