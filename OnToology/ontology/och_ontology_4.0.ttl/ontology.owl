        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The object of the equivalent class relation being removed</rdfs:comment>
        <rdfs:label>target RemoveEquivalentClass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#targetRemoveEquivalentProperty -->


