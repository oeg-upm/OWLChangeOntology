        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddEquivalentProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The subject of the equivalent property relation being added</rdfs:comment>
        <rdfs:label>source AddEquivalentProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceAddInverseProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceAddInverseProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#sourceProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddInverseProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The subject of the inverse property relation being added</rdfs:comment>
        <rdfs:label>source AddInverseProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceAddRelationToIndividual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceAddRelationToIndividual">
