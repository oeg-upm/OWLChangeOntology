        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The subject of the disjoint property relation being added</rdfs:comment>
        <rdfs:label>source add disjoint property</rdfs:label>
    </owl:ObjectProperty>
    


