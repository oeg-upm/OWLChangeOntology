        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddDisjointClass"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The subject of the disjoint class relation being added</rdfs:comment>
        <rdfs:label>source add disjoint class</rdfs:label>
    </owl:ObjectProperty>
    


