    <owl:Class rdf:about="http://www.w3.org/ns/dcat#Dataset"/>
    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- http://www.w3.org/ns/prov#SoftwareAgent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#SoftwareAgent"/>
    


    <!-- http://xmlns.com/foaf/0.1/Agent -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent"/>
    


    <!-- https://w3id.org/def/och#AddAnnotationToEntity -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddAnnotationToEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EntityAnnotationChange"/>
        <rdfs:comment>The change operation that corresponds to the addition of the annotation of an entity</rdfs:comment>
        <rdfs:label>Add Annotation to Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyCharacteristicChange"/>
        <rdfs:comment>The change operation corresponding to addition of a characteristic to a property</rdfs:comment>
        <rdfs:label>Add Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddClass -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddClass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ClassChange"/>
        <rdfs:comment>The change operation corresponding to the addition of a class</rdfs:comment>
        <rdfs:label>Add Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddDataProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddDataProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#AddProperty"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#DataPropertyChange"/>
        <rdfs:comment>The change operation corresponding to the addition of a data property</rdfs:comment>
        <rdfs:label>Add Data Property</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesAddDataProperty"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddDisjointClass -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddDisjointClass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#DisjointClassChange"/>
        <rdfs:comment>The change operation corresponding to the addition of an disjoint class relation between two classes</rdfs:comment>
        <rdfs:label>Add Disjoint Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddDisjointProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddDisjointProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#DisjointPropertyChange"/>
        <rdfs:comment>The change operation corresponding to the addition of a Disjoint Property relation between two properties</rdfs:comment>
        <rdfs:label>Add Disjoint Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddDomain -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddDomain">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#DomainChange"/>
        <rdfs:comment>The change operation corresponding to the addition of the domain to a given property</rdfs:comment>
        <rdfs:label>Add Domain</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesAddDomain"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddEquivalentClass -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddEquivalentClass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EquivalentClassChange"/>
        <rdfs:comment>The change operation corresponding to the addition of an equivalent class relation between two classes</rdfs:comment>
        <rdfs:label>Add Equivalent Class</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesAddEquivalentClass"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddEquivalentProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddEquivalentProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EquivalentPropertyChange"/>
        <rdfs:comment>The change operation corresponding to the addition of an equivalent property relation between two properties</rdfs:comment>
        <rdfs:label>Add Equivalent Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddIndividual -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddIndividual">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#IndividualChange"/>
        <rdfs:comment>The change operation corresponding to the addition of an individual to the ontology</rdfs:comment>
        <rdfs:label>Add Individual</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddInverseProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddInverseProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#InversePropertyChange"/>
        <rdfs:comment>The change operation corresponding to the addition of an inverse property relation between two properties</rdfs:comment>
        <rdfs:label>Add Inverse Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddObjectProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddObjectProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#AddProperty"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ObjectPropertyChange"/>
        <rdfs:comment>The change operation corresponding to the addition of an object property</rdfs:comment>
        <rdfs:label>Add Object Property</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesAddObjectProperty"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyChange"/>
        <rdfs:comment>The class that represents the addition of a property to an ontology</rdfs:comment>
        <rdfs:label>Add Property</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesAddProperty"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddRange -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddRange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#RangeChange"/>
        <rdfs:comment>The change operation corresponding to the addition of the range to a given property</rdfs:comment>
        <rdfs:label>Add Range</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesAddRange"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddRangeDataProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddRangeDataProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#AddRange"/>
        <rdfs:comment>The change operation corresponding to the addition of the range of a given data property</rdfs:comment>
        <rdfs:label>Add Range Data Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddRangeObjectProperty -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddRangeObjectProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#AddRange"/>
        <rdfs:comment>The change operation corresponding to the addition of the range of a given object property</rdfs:comment>
        <rdfs:label>Add Range Object Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddRelationToIndividual -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddRelationToIndividual">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#IndividualRelationChange"/>
        <rdfs:comment>The change operation corresponding to the addition of a relation between two individuals</rdfs:comment>
        <rdfs:label>Add Relation to Individual</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddSubClass -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddSubClass">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#SubClassChange"/>
        <rdfs:comment>The change operation corresponding to the addition of a subClass relation between two classes</rdfs:comment>
        <rdfs:label>Add Sub Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#AddSubPropertyOf -->


    <owl:Class rdf:about="https://w3id.org/def/och#AddSubPropertyOf">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#SubPropertyChange"/>
        <rdfs:comment>The change operation corresponding to the addition of a subProperty relation between two properties</rdfs:comment>
        <rdfs:label>Add Sub Property Of</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesAddSubPropertyOf"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#Axiom -->


    <owl:Class rdf:about="https://w3id.org/def/och#Axiom">
        <rdfs:comment xml:lang="en">An OWL axiom referenced by an impact assessment, for instance as a member of an entailment justification or as an entailment gained or lost. Where the axiom is itself recorded as a change in the changelog, :correspondingChange links the two.</rdfs:comment>
        <rdfs:label xml:lang="en">Axiom</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ChangeSet -->


    <owl:Class rdf:about="https://w3id.org/def/och#ChangeSet">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#Changelog"/>
        <rdfs:comment>The class for representing sets of changes, it can be used for representing complex changes made out of atomic changes.</rdfs:comment>
        <rdfs:label>Change Set</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#Changelog -->


    <owl:Class rdf:about="https://w3id.org/def/och#Changelog">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:comment>The set of change operations between ontology versions</rdfs:comment>
        <rdfs:label>Changelog</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ClassChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#ClassChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EntityChange"/>
        <rdfs:comment>The change operation corresponding to the change of a given class within the ontology</rdfs:comment>
        <rdfs:label>Class Change</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesClassChange"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ClassRelationChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#ClassRelationChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ClassChange"/>
        <rdfs:comment>The change operation corresponding to the change of the relationship between two classes</rdfs:comment>
        <rdfs:label>Class Relation Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ConsistencyImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/def/och#ConsistencyImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:comment xml:lang="en">An assessment of whether a change preserves the consistency of the ontology and the satisfiability of its classes.</rdfs:comment>
        <rdfs:label xml:lang="en">Consistency Impact Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#DataPropertyChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#DataPropertyChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyChange"/>
        <rdfs:comment>The change operation corresponding to the change of a data property</rdfs:comment>
        <rdfs:label>Data Property Change</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesDataPropertyChange"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#DeductiveDirection -->


    <owl:Class rdf:about="https://w3id.org/def/och#DeductiveDirection">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The top term that encompasses the directions in which an effectual change can move the deductive closure of an ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Deductive Direction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#DeprecateEntity -->


    <owl:Class rdf:about="https://w3id.org/def/och#DeprecateEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EntityChange"/>
        <rdfs:comment>The change operation corresponding to the deprecation of an OWL Entity</rdfs:comment>
        <rdfs:label>Deprecate Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#DisjointClassChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#DisjointClassChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ClassRelationChange"/>
        <rdfs:comment>The change operation corresponding to the change of an disjoint class relation between two classes</rdfs:comment>
        <rdfs:label>Disjoint Class Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#DisjointPropertyChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#DisjointPropertyChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyRelationChange"/>
        <rdfs:comment>The change operation corresponding to the change of a Disjoint Property</rdfs:comment>
        <rdfs:label>Disjoint Property Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#DomainChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#DomainChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyChange"/>
        <rdfs:comment>The change operation corresponding to the change of the domain of a given property</rdfs:comment>
        <rdfs:label>Domain Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#EntailmentJustification -->


    <owl:Class rdf:about="https://w3id.org/def/och#EntailmentJustification">
        <rdfs:comment xml:lang="en">A minimal subset of an ontology that entails a given axiom. Entailment justifications explain why an ineffectual change is ineffectual, and are the basis on which ineffectual changes are further categorised. A single change may have several justifications. Not to be confused with :justification, which records the rationale behind a change in natural language.</rdfs:comment>
        <rdfs:label xml:lang="en">Entailment Justification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#EntailmentRegime -->


    <owl:Class rdf:about="https://w3id.org/def/och#EntailmentRegime">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The top term that encompasses the semantics under which entailment is decided.</rdfs:comment>
        <rdfs:label xml:lang="en">Entailment Regime</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#EntityAnnotationChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#EntityAnnotationChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EntityChange"/>
        <rdfs:comment>The change operation that corresponds to the change of the annotation of an entity</rdfs:comment>
        <rdfs:label>Change to the Annotation of an Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#EntityChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#EntityChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#OntologicalChange"/>
        <rdfs:comment>The class that represents all changes to OWL Entities: classes, properties, and individuals</rdfs:comment>
        <rdfs:label>Entity Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#EquivalentClassChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#EquivalentClassChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ClassRelationChange"/>
        <rdfs:comment>The change operation corresponding to the change of an equivalent class relation between two classes</rdfs:comment>
        <rdfs:label>Equivalent Class Change</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesEquivalentClassChange"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#EquivalentPropertyChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#EquivalentPropertyChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyRelationChange"/>
        <rdfs:comment>The change operation corresponding to the change of an equivalent property relation between two properties</rdfs:comment>
        <rdfs:label>Equivalent Property Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ImpactAnalysis -->


    <owl:Class rdf:about="https://w3id.org/def/och#ImpactAnalysis">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">The computational process that produces one or more impact assessments. Recording it is optional, since :usedReasoner and :assessedAt cover the common case of a single tool invocation.</rdfs:comment>
        <rdfs:label xml:lang="en">Impact Analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/def/och#ImpactAssessment">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">The outcome of evaluating the impact of an ontological change, change set or changelog. An assessment is always relative to a pair of ontology versions, stated with :prevVersion and :newVersion, and where reasoning is involved to an entailment regime and a reasoner. Impact is reified rather than asserted as a type of the change itself, because whether a change is effectual holds only relative to those parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">Impact Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#IndividualChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#IndividualChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EntityChange"/>
        <rdfs:comment>The change operation corresponding to the change of a given individual within the ontology</rdfs:comment>
        <rdfs:label>Individual Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#IndividualRelationChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#IndividualRelationChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#IndividualChange"/>
        <rdfs:comment>The change operation corresponding to the change of a relationship between two individuals within the ontology</rdfs:comment>
        <rdfs:label>Individual Relation Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#InversePropertyChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#InversePropertyChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyRelationChange"/>
        <rdfs:comment>The change operation corresponding to the change of an inverse prop7 relation between two properties</rdfs:comment>
        <rdfs:label>Inverse Property Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#LogicalImpact -->


    <owl:Class rdf:about="https://w3id.org/def/och#LogicalImpact">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The top term that encompasses the possible effects of a change on the set of axioms entailed by an ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Logical Impact</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#LogicalImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/def/och#LogicalImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:comment xml:lang="en">An assessment of whether a change alters the set of axioms entailed by an ontology, that is, whether the change is logically effectual or ineffectual.</rdfs:comment>
        <rdfs:label xml:lang="en">Logical Impact Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#MaterialisationImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/def/och#MaterialisationImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:comment xml:lang="en">An assessment of the effect of a change on the materialised, that is inferred, triples of an ontology or of a knowledge graph built from it.</rdfs:comment>
        <rdfs:label xml:lang="en">Materialisation Impact Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ObjectPropertyChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#ObjectPropertyChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyChange"/>
        <rdfs:comment>The change operation corresponding to the change of an object property</rdfs:comment>
        <rdfs:label>Object Property Change</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesObjectPropertyChange"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#ObjectPropertyCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/def/och#ObjectPropertyCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyCharacteristic"/>
        <rdfs:comment xml:lang="en">The term that describes those property characteristics that are exclusive to object properties</rdfs:comment>
        <rdfs:label xml:lang="en">Object Property Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#OntologicalChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#OntologicalChange">
        <rdfs:comment>The class that represents all changes within an ontology being term-level, structural level, or higher level</rdfs:comment>
        <rdfs:label>Ontological Change</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="http://omv.ontoware.org/2007/07/OWLChangesOntologyChange"/>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#PropertyChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#PropertyChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#EntityChange"/>
        <rdfs:comment>The class that represents changes to properties</rdfs:comment>
        <rdfs:label>Property Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#PropertyCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/def/och#PropertyCharacteristic">
        <rdfs:comment xml:lang="en">The top term that encompases all characteristics</rdfs:comment>
        <rdfs:label xml:lang="en">Property Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#PropertyCharacteristicChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#PropertyCharacteristicChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyChange"/>
        <rdfs:comment>The change operation corresponding to the change of a property characteristic.</rdfs:comment>
        <rdfs:label>Property Characteristic Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#PropertyRelationChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#PropertyRelationChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyChange"/>
        <rdfs:comment>The class that represents changes to property relations</rdfs:comment>
        <rdfs:label>Property Relation Change</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/def/och#RangeChange -->


    <owl:Class rdf:about="https://w3id.org/def/och#RangeChange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/def/och#PropertyChange"/>
