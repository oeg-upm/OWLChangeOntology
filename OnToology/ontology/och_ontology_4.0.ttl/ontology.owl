    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#targetRemoveSubClass">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#targetClass"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveSubClass"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The object of the subClass relation being removed</rdfs:comment>
        <rdfs:label>target RemovesubClass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#targetRemoveSubProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#targetRemoveSubProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#targetProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveSubPropertyOf"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The object of the subProperty relation being removed</rdfs:comment>
        <rdfs:label>target RemoveSubProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#targetResource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#targetResource">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#IndividualRelationChange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The individual that is the object of the relation being changed in a change operation</rdfs:comment>
        <rdfs:label>target individual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#undeprecatedElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#undeprecatedElement">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RevokeDeprecate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The ontological term that is being undeprecated</rdfs:comment>
        <rdfs:label>undeprecated element</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#usedReasoner -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#usedReasoner">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#issuedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#Reasoner"/>
        <rdfs:comment>The reasoner used to decide entailment. Specialises :issuedBy, since a logical impact verdict is only reproducible relative to the reasoner that produced it.</rdfs:comment>
        <rdfs:label>used reasoner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- https://w3id.org/def/och#assessedAt -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#assessedAt">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The moment at which the assessment was produced.</rdfs:comment>
        <rdfs:label>assessed at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#axiomExpression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#axiomExpression">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#Axiom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A serialisation of the axiom, by default in OWL 2 Functional-Style Syntax. Use :axiomSyntax to declare a different one.</rdfs:comment>
        <rdfs:label>axiom expression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#axiomSyntax -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#axiomSyntax">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#Axiom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The concrete syntax used in :axiomExpression.</rdfs:comment>
        <rdfs:label>axiom syntax</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#classificationTimeAfter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#classificationTimeAfter">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ReasoningPerformanceAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The classification time of the new version, in milliseconds.</rdfs:comment>
        <rdfs:label>classification time after</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#classificationTimeBefore -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#classificationTimeBefore">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ReasoningPerformanceAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The classification time of the previous version, in milliseconds.</rdfs:comment>
        <rdfs:label>classification time before</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#justification -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#justification">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#OntologicalChange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The reasons and justifications behind a particular change, in natural language. Not to be confused with :EntailmentJustification, which is the set of axioms that logically entail a change.</rdfs:comment>
        <rdfs:label>justification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#justificationCount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#justificationCount">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment>The number of distinct entailment justifications found. Useful when justifications are too numerous to enumerate, and an indicator of how entrenched a redundancy is.</rdfs:comment>
        <rdfs:label>justification count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#materialisationDelta -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#materialisationDelta">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#MaterialisationImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The net change in the number of materialised triples. Negative values denote a loss of inferred content.</rdfs:comment>
        <rdfs:label>materialisation delta</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#materialisedTriplesAfter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#materialisedTriplesAfter">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#MaterialisationImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment>The size of the materialisation of the new version.</rdfs:comment>
        <rdfs:label>materialised triples after</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#materialisedTriplesBefore -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#materialisedTriplesBefore">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#MaterialisationImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment>The size of the materialisation of the previous version.</rdfs:comment>
        <rdfs:label>materialised triples before</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#preservesCoherence -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#preservesCoherence">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ConsistencyImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Whether the change introduces no new unsatisfiable classes.</rdfs:comment>
        <rdfs:label>preserves coherence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#preservesConsistency -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#preservesConsistency">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ConsistencyImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Whether the new version is consistent, given that the previous one was.</rdfs:comment>
        <rdfs:label>preserves consistency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/def/och#reasoningTimeout -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/def/och#reasoningTimeout">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The time limit in seconds applied to each entailment check. Stating it is what makes an :Undetermined verdict interpretable.</rdfs:comment>
        <rdfs:label>reasoning timeout</rdfs:label>
    </owl:DatatypeProperty>
    


