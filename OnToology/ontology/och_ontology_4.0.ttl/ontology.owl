<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/def/och#"
     xml:base="https://w3id.org/def/och"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/def/och#">
        <owl:versionIRI rdf:resource="https://w3id.org/def/och/4.0.0"/>
        <ns:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
        <terms:abstract>As any other engineering product, ontologies evolve during their lifecycle due to several reasons such as accommodating new requirements or fixing issues. To keep track of these changes, several tools have defined ad-hoc formalisms to define and manage them. However, some of them are not based on standard interoperable languages such as RDF, and the RDF-based ones cover a limited set of changes. In this paper, we present the OWL Change Ontology (OCH), an ontology to capture changes in ontologies. Developed following the LOT methodology, OCH provides a declarative framework for documenting ontology changelogs. With this approach, ontologies gain a valuable resource to improve their lifecycle management, while associated semantic products such as declarative mappings (e.g., RML) and validation shapes (e.g., SHACL) can take advantage of standardized and machine-readable changelogs to streamline their schema evolution.</terms:abstract>
        <terms:bibliographicCitation>Conde-Herreros, D. Pernisch, R., Poveda-Villalón, M., Corcho, O., &amp; Chaves-Fraga, D. (2024). OCH: The OWL Change Ontology</terms:bibliographicCitation>
        <terms:contributor>Diego Conde Herreros</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-17</terms:created>
        <terms:creator>David Chaves-Fraga</terms:creator>
        <terms:creator>Diego Conde-Herreros</terms:creator>
        <terms:creator>María Poveda-Villalón</terms:creator>
        <terms:creator>Oscar Corcho</terms:creator>
        <terms:creator>Romana Pernisch</terms:creator>
        <terms:description>An ontology for describing changes between OWL ontology versions and the logical and computational impact of those changes</terms:description>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-11</terms:modified>
        <terms:title>OWL Change Ontology</terms:title>
        <vann:preferredNamespacePrefix>och</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://w3id.org/def/och#"/>
        <owl:priorVersion rdf:resource="https://w3id.org/def/och/3.0.0"/>
        <owl:versionInfo xml:lang="en">4.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://creativecommons.org/ns#license -->


    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2002/07/owl#priorVersion -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#priorVersion"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    


    <!-- https://w3id.org/mod#createdWith -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mod#createdWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#boolean -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#boolean"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#dateTime -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#dateTime"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#decimal -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#decimal"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#integer -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#nonNegativeInteger -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#string -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#hasTopConcept -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#hasTopConcept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- https://w3id.org/def/och#addedAnnotationToEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedAnnotationToEntity">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddAnnotationToEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The annotation property being added to an entity. Its range is rdf:Property to include both owl:AnnotationProperty and other annotations.</rdfs:comment>
        <rdfs:label>added annotation to entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedCharacteristic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedCharacteristic">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddCharacteristic"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#PropertyCharacteristic"/>
        <rdfs:comment>The characteristic being added to a given property</rdfs:comment>
        <rdfs:label>added characteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedCharacteristicToProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedCharacteristicToProperty">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddCharacteristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The property a characteristic is added to</rdfs:comment>
        <rdfs:label>add Characteristic to property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedClass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedClass">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#addedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddClass"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The class being added in an AddClass operation</rdfs:comment>
        <rdfs:label>added class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedDataProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedDataProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#addedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
        <rdfs:comment>The data property that is being added to the ontology</rdfs:comment>
        <rdfs:label>added data property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedDataRange -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedDataRange">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddRangeDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
        <rdfs:comment>The range being added to a data property</rdfs:comment>
        <rdfs:label>added data range</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedDomain -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedDomain">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The added domain of an Add Domain change operation</rdfs:comment>
        <rdfs:label>added domain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedDomainToProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedDomainToProperty">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The property a domain is added to.</rdfs:comment>
        <rdfs:label>added Domain for Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedEntity">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#EntityChange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The entity that is being added in a change operation</rdfs:comment>
        <rdfs:label>added entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedIndividual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedIndividual">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#addedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddIndividual"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:comment>The individual being added in an AddIndividual operation</rdfs:comment>
        <rdfs:label>added individual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedObjectProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedObjectProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#addedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddObjectProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
        <rdfs:comment>The object property being added to the ontology</rdfs:comment>
        <rdfs:label>added object property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedObjectRange -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedObjectRange">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddRangeObjectProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The range that is being added to the object property</rdfs:comment>
        <rdfs:label>added object range</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#addedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The property being added to the ontology</rdfs:comment>
        <rdfs:label>added Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedRangeToProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedRangeToProperty">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddRange"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The property to which the change is being added.</rdfs:comment>
        <rdfs:label>add range for property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#addedRelationToIndividual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#addedRelationToIndividual">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddRelationToIndividual"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The individual that is the relation being added in a change operation</rdfs:comment>
        <rdfs:label>property add relation to individuals</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#affectsTerm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#affectsTerm">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>An entity whose meaning is altered by the change.</rdfs:comment>
        <rdfs:label>affects term</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#assesses -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#assesses">
        <owl:inverseOf rdf:resource="https://w3id.org/def/och#hasImpactAssessment"/>
        <rdfs:comment>The ontological change, change set or changelog whose impact is assessed.</rdfs:comment>
        <rdfs:label>assesses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#changeCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#changeCategory">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment>A fine-grained category assigned to the change, drawn from :ChangeCategoryScheme or from an external concept scheme.</rdfs:comment>
        <rdfs:label>change category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#correspondingChange -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#correspondingChange">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#Axiom"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#OntologicalChange"/>
        <rdfs:comment>Links an axiom to the ontological change that introduced or removed it, when such a change is recorded in the changelog. This allows tracing why a change is ineffectual back to other changes in the same release.</rdfs:comment>
        <rdfs:label>corresponding change</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#deductiveDirection -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#deductiveDirection">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#DeductiveDirection"/>
        <rdfs:comment>The direction in which an effectual change moves the deductive closure of the ontology.</rdfs:comment>
        <rdfs:label>deductive direction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#deprecatedEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#deprecatedEntity">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#DeprecateEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The OWL Entity that is being deprecated</rdfs:comment>
        <rdfs:label>deprecated entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#directlyAffectsTerm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#directlyAffectsTerm">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#affectsTerm"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>An entity that occurs in the changed axiom itself and whose meaning is altered by it.</rdfs:comment>
        <rdfs:label>directly affects term</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#entailmentRegime -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#entailmentRegime">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#EntailmentRegime"/>
        <rdfs:comment>The semantics under which entailment was decided.</rdfs:comment>
        <rdfs:label>entailment regime</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#fromChangelog -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#fromChangelog">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#OntologicalChange"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#Changelog"/>
        <rdfs:comment>The fromChangelog property indicates that a given change belongs to a Changelog</rdfs:comment>
        <rdfs:label>from changelog</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#gainedEntailment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#gainedEntailment">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#Axiom"/>
        <rdfs:comment>An axiom entailed by the new version but not by the previous one.</rdfs:comment>
        <rdfs:label>gained entailment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#hasEntailmentJustification -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#hasEntailmentJustification">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#EntailmentJustification"/>
        <rdfs:comment>A minimal set of axioms explaining the verdict, typically the axioms of the previous version that already entail an ineffectually added axiom.</rdfs:comment>
        <rdfs:label>has entailment justification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#hasImpactAssessment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#hasImpactAssessment">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/def/och#Changelog"/>
                    <rdf:Description rdf:about="https://w3id.org/def/och#OntologicalChange"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/def/och#ImpactAssessment"/>
        <rdfs:comment>Relates an ontological change or a changelog to an assessment of its impact. Since :ChangeSet is a subclass of :Changelog, assessments of change sets are covered as well and express aggregate impact.</rdfs:comment>
        <rdfs:label>has impact assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#hasLogicalImpact -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#hasLogicalImpact">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#OntologicalChange"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#LogicalImpact"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/def/och#hasImpactAssessment"/>
            <rdf:Description rdf:about="https://w3id.org/def/och#logicalImpact"/>
        </owl:propertyChainAxiom>
        <rdfs:comment>Shortcut relating a change directly to its logical impact, for consumers that do not need provenance. It is entailed by the chain of :hasImpactAssessment and :logicalImpact, and should not be the only representation when more than one assessment of the same change exists.</rdfs:comment>
        <rdfs:label>has logical impact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#indirectlyAffectsTerm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#indirectlyAffectsTerm">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#affectsTerm"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>An entity whose meaning is altered by the change although it does not occur in the changed axiom. Separating direct from indirect effects is what makes an impact report actionable for an ontology engineer.</rdfs:comment>
        <rdfs:label>indirectly affects term</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#introducesUnsatisfiableClass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#introducesUnsatisfiableClass">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ConsistencyImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>A class that is satisfiable in the previous version and unsatisfiable in the new one.</rdfs:comment>
        <rdfs:label>introduces unsatisfiable class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#issuedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#issuedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/def/och#ImpactAssessment"/>
                    <rdf:Description rdf:about="https://w3id.org/def/och#OntologicalChange"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:comment>The issuedBy property indicates what Agent has issued a change or produced an impact assessment.</rdfs:comment>
        <rdfs:label>issued by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#justifyingAxiom -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#justifyingAxiom">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#EntailmentJustification"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#Axiom"/>
        <rdfs:comment>An axiom belonging to an entailment justification.</rdfs:comment>
        <rdfs:label>justifying axiom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#logicalImpact -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#logicalImpact">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#LogicalImpact"/>
        <rdfs:comment>The logical impact established by an assessment. Functional: a single assessment yields exactly one verdict. Divergent verdicts must be expressed as separate assessments with distinct provenance.</rdfs:comment>
        <rdfs:label>logical impact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#lostEntailment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#lostEntailment">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#LogicalImpactAssessment"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#Axiom"/>
        <rdfs:comment>An axiom entailed by the previous version but not by the new one.</rdfs:comment>
        <rdfs:label>lost entailment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#newVersion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#newVersion">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/def/och#Changelog"/>
                    <rdf:Description rdf:about="https://w3id.org/def/och#ImpactAssessment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
        <rdfs:comment>The new version the ontology is updated to. When stated on an impact assessment, the version against which removals are evaluated.</rdfs:comment>
        <rdfs:label>new version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#outdatedEntityName -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#outdatedEntityName">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RenameEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The former name of the OWL Entity that has been renamed</rdfs:comment>
        <rdfs:label>outdated entity name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#prevVersion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#prevVersion">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/def/och#Changelog"/>
                    <rdf:Description rdf:about="https://w3id.org/def/och#ImpactAssessment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
        <rdfs:comment>The former version of the ontology that is being outdated. When stated on an impact assessment, the version against which additions are evaluated.</rdfs:comment>
        <rdfs:label>previous version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#relatedChange -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#relatedChange">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#OntologicalChange"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#OntologicalChange"/>
        <rdfs:comment>The property that indicates an unspecified relation between two Ontology Changes</rdfs:comment>
        <rdfs:label>related change</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedAnnotationFromEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedAnnotationFromEntity">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveAnnotationFromEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The annotation property being removed from an entity. Its range is rdf:Property to include both owl:AnnotationProperty and other annotations.</rdfs:comment>
        <rdfs:label>removed annotation from entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedCharacteristic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedCharacteristic">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveCharacteristic"/>
        <rdfs:range rdf:resource="https://w3id.org/def/och#PropertyCharacteristic"/>
        <rdfs:comment>The characteristic that is being removed from a property</rdfs:comment>
        <rdfs:label>removed characteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedCharacteristicFromProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedCharacteristicFromProperty">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveCharacteristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The property a characteristicic is removed from</rdfs:comment>
        <rdfs:label>property RemoveCharacteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedClass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedClass">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#removedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveClass"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The class that is being removed in an ontology</rdfs:comment>
        <rdfs:label>removed class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedDataProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedDataProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#removedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
        <rdfs:comment>The data property that is being removed in an ontology</rdfs:comment>
        <rdfs:label>removed data property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedDataRange -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedDataRange">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveRangeDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
        <rdfs:comment>The range that is being removed from a Datatype Property</rdfs:comment>
        <rdfs:label>removed data range</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedDomain -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedDomain">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The domain that is being removed from a property</rdfs:comment>
        <rdfs:label>removed domain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedDomainFromProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedDomainFromProperty">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveDomain"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The property a domain is removed from</rdfs:comment>
        <rdfs:label>removed Domain for Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedEntity">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#EntityChange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The entity that is being removed in a change operation</rdfs:comment>
        <rdfs:label>removed entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedIndividual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedIndividual">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#removedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveIndividual"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:comment>The individual that is being removed in an ontology</rdfs:comment>
        <rdfs:label>removed individual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedObjectProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedObjectProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#removedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveObjectProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
        <rdfs:comment>The object property being removed from an ontology</rdfs:comment>
        <rdfs:label>removed object property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedObjectRange -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedObjectRange">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveRangeObjectProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The range being removed from an object property</rdfs:comment>
        <rdfs:label>removed object range</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#removedEntity"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The property being removed from the ontology</rdfs:comment>
        <rdfs:label>removed Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedRangeFromProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedRangeFromProperty">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveRange"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The removed range for a property</rdfs:comment>
        <rdfs:label>removed range for property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#removedRelationFromIndividual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#removedRelationFromIndividual">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveRelationtoIndividual"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The relation being removed from an individual in a change operation</rdfs:comment>
        <rdfs:label>removed relation from individuals</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#renamedEntityName -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#renamedEntityName">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RenameEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The new name the OWL Entity is being renamed to</rdfs:comment>
        <rdfs:label>renamed entity name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#repairsUnsatisfiableClass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#repairsUnsatisfiableClass">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#ConsistencyImpactAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>A class that is unsatisfiable in the previous version and satisfiable in the new one.</rdfs:comment>
        <rdfs:label>repairs unsatisfiable class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceAddAnnotationToEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceAddAnnotationToEntity">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddAnnotationToEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The Entity the annotation is added to</rdfs:comment>
        <rdfs:label>source add annotation to entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceAddDisjointClass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceAddDisjointClass">
