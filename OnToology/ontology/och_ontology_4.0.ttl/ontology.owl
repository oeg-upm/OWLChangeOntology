        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddEquivalentClass"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The subject of the equivalent class relation being added</rdfs:comment>
        <rdfs:label>source add equivalent class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceAddEquivalentProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceAddEquivalentProperty">
