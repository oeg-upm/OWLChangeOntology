    <!-- https://w3id.org/def/och#Undetermined -->


    <owl:NamedIndividual rdf:about="https://w3id.org/def/och#Undetermined">
        <rdf:type rdf:resource="https://w3id.org/def/och#LogicalImpact"/>
        <skos:inScheme rdf:resource="https://w3id.org/def/och#LogicalImpactScheme"/>
        <rdfs:comment xml:lang="en">The logical impact could not be decided, for instance because the entailment check exceeded the time limit stated in :reasoningTimeout, because the reasoner is incomplete for the expressivity of the ontology, or because one of the versions could not be loaded. The value is asserted positively so that an undecided change remains distinguishable from an unassessed one.</rdfs:comment>
        <rdfs:label xml:lang="en">Undetermined</rdfs:label>
        <skos:prefLabel xml:lang="en">Undetermined</skos:prefLabel>
    </owl:NamedIndividual>
    


