        <rdfs:comment>The object of the inverse property relation being removed</rdfs:comment>
        <rdfs:label>target RemoveInverseProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#targetRemoveRelationToIndividual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#targetRemoveRelationToIndividual">
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveRelationtoIndividual"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment>The individual that is the object of the relation being removed in a change operation</rdfs:comment>
        <rdfs:label>target remove relation to individuals</rdfs:label>
    </owl:ObjectProperty>
    


