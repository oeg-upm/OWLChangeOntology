        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:comment>The individual that is the subject of the relation being added in a change operation</rdfs:comment>
        <rdfs:label>source add relation to individuals</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceAddSubClass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceAddSubClass">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#sourceClass"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#AddSubClass"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment>The subject of the subClass relation being added</rdfs:comment>
        <rdfs:label>source AddSubClass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/def/och#sourceAddSubProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/def/och#sourceAddSubProperty">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#sourceProperty"/>
