        <rdfs:subPropertyOf rdf:resource="https://w3id.org/def/och#targetProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/def/och#RemoveEquivalentProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment>The object of the equivalent class relation being removed</rdfs:comment>
        <rdfs:label>target RemoveEquivalentProperty</rdfs:label>
    </owl:ObjectProperty>
    


