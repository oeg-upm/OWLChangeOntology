  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The change operation corresponding to the addition of the range of a given object property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Add Range Object Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/och#AddRange"
  } ]
}, {
