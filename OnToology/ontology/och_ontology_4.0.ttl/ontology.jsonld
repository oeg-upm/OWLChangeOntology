  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The change operation corresponding to the addition of an inverse property relation between two properties"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Add Inverse Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/def/och#InversePropertyChange"
  } ]
