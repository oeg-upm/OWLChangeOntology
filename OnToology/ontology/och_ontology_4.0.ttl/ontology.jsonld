}, {
  "@id" : "https://w3id.org/def/och#",
  "http://creativecommons.org/ns#license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/legalcode"
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@value" : "As any other engineering product, ontologies evolve during their lifecycle due to several reasons such as accommodating new requirements or fixing issues. To keep track of these changes, several tools have defined ad-hoc formalisms to define and manage them. However, some of them are not based on standard interoperable languages such as RDF, and the RDF-based ones cover a limited set of changes. In this paper, we present the OWL Change Ontology (OCH), an ontology to capture changes in ontologies. Developed following the LOT methodology, OCH provides a declarative framework for documenting ontology changelogs. With this approach, ontologies gain a valuable resource to improve their lifecycle management, while associated semantic products such as declarative mappings (e.g., RML) and validation shapes (e.g., SHACL) can take advantage of standardized and machine-readable changelogs to streamline their schema evolution."
  } ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "Conde-Herreros, D. Pernisch, R., Poveda-Villalón, M., Corcho, O., & Chaves-Fraga, D. (2024). OCH: The OWL Change Ontology"
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "Diego Conde Herreros"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-04-17"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "David Chaves-Fraga"
  }, {
    "@value" : "Diego Conde-Herreros"
  }, {
    "@value" : "María Poveda-Villalón"
  }, {
    "@value" : "Oscar Corcho"
  }, {
    "@value" : "Romana Pernisch"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "An ontology for describing changes between OWL ontology versions and the logical and computational impact of those changes"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-11"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@value" : "OWL Change Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "och"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@id" : "https://w3id.org/def/och#"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@id" : "https://w3id.org/def/och/3.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/def/och/4.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "en",
    "@value" : "4.0.0"
  } ]
