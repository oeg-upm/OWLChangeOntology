  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Links an axiom to the ontological change that introduced or removed it, when such a change is recorded in the changelog. This allows tracing why a change is ineffectual back to other changes in the same release."
