    "@value" : "An entity that occurs in the changed axiom itself and whose meaning is altered by it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "directly affects term"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Resource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/och#affectsTerm"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#entailmentRegime",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The semantics under which entailment was decided."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#ImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "entailment regime"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#EntailmentRegime"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#fromChangelog",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The fromChangelog property indicates that a given change belongs to a Changelog"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#OntologicalChange"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "from changelog"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#Changelog"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#gainedEntailment",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An axiom entailed by the new version but not by the previous one."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "gained entailment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#Axiom"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#hasEntailmentJustification",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A minimal set of axioms explaining the verdict, typically the axioms of the previous version that already entail an ineffectually added axiom."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has entailment justification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#EntailmentJustification"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#hasImpactAssessment",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relates an ontological change or a changelog to an assessment of its impact. Since :ChangeSet is a subclass of :Changelog, assessments of change sets are covered as well and express aggregate impact."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid1"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has impact assessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#ImpactAssessment"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#hasLogicalImpact",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Shortcut relating a change directly to its logical impact, for consumers that do not need provenance. It is entailed by the chain of :hasImpactAssessment and :logicalImpact, and should not be the only representation when more than one assessment of the same change exists."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#OntologicalChange"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has logical impact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpact"
  } ],
  "http://www.w3.org/2002/07/owl#propertyChainAxiom" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/def/och#hasImpactAssessment"
    }, {
      "@id" : "https://w3id.org/def/och#logicalImpact"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/def/och#indirectlyAffectsTerm",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An entity whose meaning is altered by the change although it does not occur in the changed axiom. Separating direct from indirect effects is what makes an impact report actionable for an ontology engineer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "indirectly affects term"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Resource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/def/och#affectsTerm"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#introducesUnsatisfiableClass",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A class that is satisfiable in the previous version and unsatisfiable in the new one."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#ConsistencyImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "introduces unsatisfiable class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#issuedBy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The issuedBy property indicates what Agent has issued a change or produced an impact assessment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid6"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "issued by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://xmlns.com/foaf/0.1/Agent"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#justification",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The reasons and justifications behind a particular change, in natural language. Not to be confused with :EntailmentJustification, which is the set of axioms that logically entail a change."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#OntologicalChange"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "justification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#justificationCount",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The number of distinct entailment justifications found. Useful when justifications are too numerous to enumerate, and an indicator of how entrenched a redundancy is."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "justification count"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#justifyingAxiom",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An axiom belonging to an entailment justification."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#EntailmentJustification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "justifying axiom"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#Axiom"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#logicalImpact",
  "@type" : [ "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The logical impact established by an assessment. Functional: a single assessment yields exactly one verdict. Divergent verdicts must be expressed as separate assessments with distinct provenance."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "logical impact"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpact"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#lostEntailment",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An axiom entailed by the previous version but not by the new one."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#LogicalImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "lost entailment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#Axiom"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#materialisationDelta",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The net change in the number of materialised triples. Negative values denote a loss of inferred content."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#MaterialisationImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "materialisation delta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#materialisedTriplesAfter",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The size of the materialisation of the new version."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#MaterialisationImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "materialised triples after"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#materialisedTriplesBefore",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The size of the materialisation of the previous version."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#MaterialisationImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "materialised triples before"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#newVersion",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The new version the ontology is updated to. When stated on an impact assessment, the version against which removals are evaluated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid9"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "new version"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Ontology"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#outdatedEntityName",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The former name of the OWL Entity that has been renamed"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#RenameEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "outdated entity name"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Resource"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#preservesCoherence",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Whether the change introduces no new unsatisfiable classes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#ConsistencyImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "preserves coherence"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#preservesConsistency",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Whether the new version is consistent, given that the previous one was."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#ConsistencyImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "preserves consistency"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#prevVersion",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The former version of the ontology that is being outdated. When stated on an impact assessment, the version against which additions are evaluated."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid12"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "previous version"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Ontology"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#reasoningTimeout",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#DatatypeProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The time limit in seconds applied to each entailment check. Stating it is what makes an :Undetermined verdict interpretable."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#ImpactAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "reasoning timeout"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#relatedChange",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The property that indicates an unspecified relation between two Ontology Changes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/def/och#OntologicalChange"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "related change"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/def/och#OntologicalChange"
  } ]
}, {
  "@id" : "https://w3id.org/def/och#removedAnnotationFromEntity",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
